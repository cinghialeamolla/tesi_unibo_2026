# 1. Installa e carica knitr (se non lo hai già fatto)
if(!require(knitr)) install.packages("knitr")
library(knitr)

# 2. Genera automaticamente il file .bib con TUTTI i pacchetti attivi
write_bib(x = .packages(), file = "bibliografia_pacchetti.bib")

library(readxl)    # Per il caricamento dei fogli Excel (.xlsx)
library(vegan)     # Per l'analisi ecologica multivariate e indici comunitari
library(car)       # Fondamentale per il test di Levene e l'ANOVA di Tipo III (funzione Anova)
library(MASS)      # Richiesto per la modellazione avanzata di conteggi (funzione glm.nb)
