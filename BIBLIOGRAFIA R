library(nlme)      # Per i modelli GLS (Generalized Least Squares) con pesi varIdent
library(ggdist)    # Per la creazione di grafici avanzati sulla distribuzione dei dati
library(officer)   # Permette ad R di scrivere e salvare direttamente documenti in Word (.docx)
