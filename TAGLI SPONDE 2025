stat_desc <- dati_wilcoxon_wide %>%
  summarise(
    N_Coppie = n(),
    Mediana_Integra  = median(integra),
    IQR_Integra      = IQR(integra),
    Mediana_Tagliata = median(tagliata),
    IQR_Tagliata     = IQR(tagliata)
  )

# Cro il dataframe unendo le statistiche e l'output del test (V=295, p=0.0001074)
df_tabella_wilc <- tibble(
  Confronto        = "Sponda Integra vs Sponda Tagliata (Tratto T3)",
  N                = stat_desc$N_Coppie,
  `Mediana (IQR) Integra`  = paste0(stat_desc$Mediana_Integra, " (±", stat_desc$IQR_Integra, ")"),
  `Mediana (IQR) Tagliata` = paste0(stat_desc$Mediana_Tagliata, " (±", stat_desc$IQR_Tagliata, ")"),
  `Statistica V`   = 295,
  `p-value`        = 0.0001074
)

