# ==============================================================================
# ---- ANALISI SIMPER (Quali specie creano la differenza?) ----
# ==============================================================================
# Obiettivo: Creare una matrice multivariata dove ogni "Sito" è la combinazione 
# tra il Segmento e la Sponda (es. "T3_02T_2025_integra").

# Prepariamo la matrice comunitaria
dati_simper <- specie |>
  filter(SPONDA %in% c("integra", "tagliata")) |> 
  # Creiamo un ID univoco per il "Sub-sito" (Segmento + Sponda)
  mutate(SITO_SPONDA = paste(ID_SEGMENTO, SPONDA, sep = "_")) %>%
  group_by(SITO_SPONDA, SPECIE) %>%
  summarise(CONTEGGIO = sum(CONTEGGIO), .groups = "drop") %>%
  pivot_wider(names_from = SPECIE, values_from = CONTEGGIO, values_fill = 0) %>%
  column_to_rownames("SITO_SPONDA")

# Prepariamo il vettore dei gruppi (integra/tagliata) 
# IMPORTANTE: L'ordine deve coincidere esattamente con le righe della matrice
vettore_sponde <- str_extract(rownames(dati_simper), "integra|tagliata")

# Lanciamo la SIMPER
# Permutations = 999 calcola anche la significatività statistica del contributo 
# di ogni singola specie alla differenza complessiva
risultato_simper <- simper(dati_simper, group = vettore_sponde, permutations = 999)

print("--- RISULTATO SIMPER ---")
# Summary mostra le specie ordinate per contributo (chi spiega più differenza sta in alto)
summary(risultato_simper)

# ava e avb: Sono le abbondanze medie della specie nei due gruppi
# ava = integra e avb = tagliata (R le mette in ordine alfabetico, i prima di t)
# average: è il "peso" (il contributo assoluto) che quella specie ha nel creare la differenza totale tra le due sponde
# Più è alto, più la specie è responsabile del cambiamento
# cumsum (Cumulative Sum): ti dice quanta parte della differenza totale tra le due sponde è spiegata accumulando le specie riga per riga.
# p-value (p): ti dice se il contributo di quella specie alla differenza tra i due habitat è statisticamente significativo (se ***, significa che il pattern non è casuale)


# =====================================================================
# ---- ESTRAZIONE E GENERAZIONE TABELLA SIMPER SPONDE T3 ----
# =====================================================================


# Trasformo l'output SIMPER usando dplyr::select per evitare conflitti con MASS o terra
df_simper_sponde <- as.data.frame(risultato_simper$integra_tagliata) %>%
  rownames_to_column(var = "Specie") %>%
  # Ordino le specie per importanza decrescente (contributo più alto in cima)
  arrange(desc(average)) %>%
  # Isolo le prime 7 specie strutturali (oltre il 60% della dissomiglianza)
  slice_head(n = 7) %>%
  # FORZO dplyr::select e uso 'cusum' (nome corretto nell'output di vegan)
  dplyr::select(Specie, average, ava, avb, cusum, p) %>%
  mutate(
    Contrib_Percentuale = (average / sum(risultato_simper$integra_tagliata$average)) * 100,
    Cumul_Percentuale   = cusum * 100
  ) %>%
  # Forzo dplyr::select anche qui per riordinare le colonne finali
  dplyr::select(Specie, ava, avb, Contrib_Percentuale, Cumul_Percentuale, p)

# Creazione della Flextable formattata per Word 
tabella_simper_sponde <- flextable(df_simper_sponde) %>%
  set_header_labels(
    Specie            = "Specie di Uccello",
    ava               = "Abbondanza Media Integra",
    avb               = "Abbondanza Media Tagliata",
    Contrib_Percentuale = "Contributo Singolo (%)",
    Cumul_Percentuale = "Contributo Cumulativo (%)",
    p                 = "p-value"
  ) %>%
  # Formattazione con la virgola decimale 
  colformat_double(j = c("ava", "avb", "Contrib_Percentuale", "Cumul_Percentuale"), digits = 2, decimal.mark = ",", big.mark = "") %>%
  colformat_double(j = "p", digits = 3, decimal.mark = ",", big.mark = "") %>%
  # Sostituzione formale del p-value minimo con gli asterischi standard
  labelizor(j = "p", labels = c("0,001" = "< 0,001 ***"), part = "body") %>%
  theme_booktabs() %>%
  autofit() %>%
  bold(part = "header") %>%
  flextable::align(align = "center", part = "all") %>%
  flextable::align(j = "Specie", align = "left", part = "all")

