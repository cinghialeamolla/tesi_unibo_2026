## ---- chi-quadro: la struttura della comunità (chi c'è e in che proporzione) è cambiata a causa del taglio? ----
###====================================================================

# Creo la tabella solo con i conteggi ASSOLUTI (escludendo la colonna coi nomi delle specie)
# tab_conteggi <- data.frame(Destra = c(15, 5, 6...), Sinistra = c(1, 0, 10...))

tabella_chi_quadro <- specie |>
  filter(SPONDA %in% c("integra", "tagliata")) |> 
  group_by(SPECIE, SPONDA) %>%
  # Sommo le abbondanze per ogni specie nelle due sponde
  summarise(Abbondanza_Tot = sum(CONTEGGIO), .groups = "drop") %>%
  # Metto 'integra' e 'tagliata' come colonne
  pivot_wider(names_from = SPONDA, values_from = Abbondanza_Tot, values_fill = 0) %>%
  # Sposto il nome della specie nel nome della riga (formato richiesto dal test)
  column_to_rownames("SPECIE")

# Arrotondo la tabella per sicurezza (ci sono i valori "0,5")
tabella_chi_quadro <- round(tabella_chi_quadro, 0)
# Elimino le "specie fantasma" (righe in cui la somma è esattamente 0)
tabella_chi_pulita <- tabella_chi_quadro[rowSums(tabella_chi_quadro) > 0, ]

print("--- TABELLA PER CHI-QUADRO ---")
head(tabella_chi_pulita)

# Eseguo il test con simulazione Monte Carlo (Risolve il Warning)
# L'approssimazione al Chi-quadrato potrebbe essere inesatta
set.seed(123)
test_chi <- chisq.test(tabella_chi_pulita, simulate.p.value = TRUE, B = 9999)

print("--- RISULTATO CHI-QUADRO ---")
print(test_chi)

# OUTPUT 
# Pearson's Chi-squared test with simulated p-value (based on 9999 replicates)
# data:  tabella_chi_pulita
# X-squared = 119.69, df = NA, p-value = 1e-04


# Estrazione e pulizia di TUTTI i residui di Pearson
residui_completi <- as.data.frame(test_chi$residuals) %>%
  rownames_to_column(var = "Specie") %>%
  rename(Residuo_Integra = integra, Residuo_Tagliata = tagliata)

# Seleziono le specie chiave che deviano di più (Residuo assoluto > 1.5) per la tabella e il grafico
specie_chiave <- residui_completi %>%
  filter(abs(Residuo_Integra) >= 1.5 | abs(Residuo_Tagliata) >= 1.5) %>%
  arrange(desc(Residuo_Integra))

# CREAZIONE TABELLA PER WORD (Flextable)
tabella_chi_word <- flextable(specie_chiave) %>%
  set_header_labels(
    Specie           = "Specie di Uccello",
    Residuo_Integra  = "Residuo Sponda Integra",
    Residuo_Tagliata = "Residuo Sponda Tagliata"
  ) %>%
  colformat_double(j = c("Residuo_Integra", "Residuo_Tagliata"), digits = 3, decimal.mark = ",", big.mark = "") %>%
  theme_booktabs() %>%
  autofit() %>%
  bold(part = "header") %>%
  # Colora in rosso i residui fortemente significativi (> 2 o < -2)
  color(i = ~ Residuo_Integra > 2 | Residuo_Integra < -2, j = "Residuo_Integra", color = "firebrick", part = "body") %>%
  color(i = ~ Residuo_Tagliata > 2 | Residuo_Tagliata < -2, j = "Residuo_Tagliata", color = "firebrick", part = "body") %>%
  flextable::align(align = "center", part = "all") %>%
  flextable::align(j = "Specie", align = "left", part = "all")

# Salvo Tabella in Word
save_as_docx(tabella_chi_word, path = "C:/RTesi/Tabella_Residui_ChiQuadro.docx")


