## ---- test di wilcoxon: l'impatto del taglio ha ridotto o aumentato in modo significativo il numero di specie per unità di spazio? ----

# Sono ricchezze, i dati non sono normali, o comunque per analogia con il resto della tesi
# in cui abbiamo usato quasi poisson, qui si usa Wilcoxon:
dati_wilcoxon <- specie |>
  filter(SPONDA %in% c("integra", "tagliata")) |> 
  # Escludiamo eventuali zeri (se presenti nel dataset originale)
  filter(CONTEGGIO > 0) |> 
  # Raggruppiamo per segmento e sponda
  group_by(ID_SEGMENTO, SPONDA) |> 
  # Contiamo quante specie diverse ci sono (Ricchezza S)
  summarise(Ricchezza_S = n_distinct(SPECIE), .groups = "drop")

dati_wilcoxon_wide <- dati_wilcoxon |> 
  # Affianchiamo le due sponde (Wide format)
  pivot_wider(names_from = SPONDA, values_from = Ricchezza_S, values_fill = 0)

print("--- TABELLA PER WILCOXON ---")
print(dati_wilcoxon_wide)

# Eseguiamo il test non parametrico accoppiato (paired = TRUE)
test_wilcoxon <- wilcox.test(dati_wilcoxon_wide$integra, dati_wilcoxon_wide$tagliata, paired = TRUE)

print("--- RISULTATO WILCOXON TEST ---")
print(test_wilcoxon)

# OUTPUT
 # Wilcoxon signed rank exact test

# data:  dati_wilcoxon_wide$integra and dati_wilcoxon_wide$tagliata
# V = 295, p-value = 0.0001074
# alternative hypothesis: true location shift is not equal to 0

