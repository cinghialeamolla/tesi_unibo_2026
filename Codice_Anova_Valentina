      N_segmenti = n(),
      S_media = mean(Ricchezza_S, na.rm = TRUE),
      S_dev_std = sd(Ricchezza_S, na.rm = TRUE),
      H_media = mean(Shannon_H, na.rm = TRUE),
      H_dev_std = sd(Shannon_H, na.rm = TRUE),
      J_media = mean(Evenness_J, na.rm = TRUE),
      J_dev_std = sd(Evenness_J, na.rm = TRUE)
    )
  # Formattiamo la tabella
  tabella_riassuntiva_formattata <- tabella_riassuntiva |>
    mutate(
      `Ricchezza (S)` = sprintf("%.2f ± %.2f", S_media, S_dev_std),
      `Shannon (H')` = sprintf("%.2f ± %.2f", H_media, H_dev_std),
      `Evenness (J')` = sprintf("%.2f ± %.2f", J_media, J_dev_std)
    ) %>%
    select(
      NOME_TRATTO,
      N_segmenti,
      `Ricchezza (S)`,
      `Shannon (H')`,
      `Evenness (J')`
    )
}
