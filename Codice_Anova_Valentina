{
  indici_calcolati <- tibble(
    ID_SEGMENTO = rownames(matrice_comunita),
    Ricchezza_S = specnumber(matrice_comunita), # N° specie
    Shannon_H = diversity(matrice_comunita, index = "shannon"), # Indice di Shannon
    Evenness_J = Shannon_H / log(Ricchezza_S) # Pielou J
  )
}


# Uniamo gli indici alle informazioni ambientali dei segmenti
dataset_analisi_1 <- seg_2025 %>%
  left_join(indici_calcolati, by = "ID_SEGMENTO")

