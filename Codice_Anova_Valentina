      p.value < 0.001 ~ "***",
      p.value < 0.01  ~ "**",
      p.value < 0.05  ~ "*",
      TRUE            ~ "NS"
    ),
    # Arrotondo il p-value per visualizzarlo in modo pulito
    p.value = if_else(p.value < 0.001, "< 0,001", as.character(round(p.value, 4)))
  ) %>%
  # Seleziono le colonne
  select(term, estimate, std.error, statistic, p.value, Signif)


