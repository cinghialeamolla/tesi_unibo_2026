                            family = poisson(link = "log"),
                            data = dataset_specialisti)

# Controllo rapido della dispersione
ratio_disp_spec <- glm_specialisti_pois$deviance / glm_specialisti_pois$df.residual

if (ratio_disp_spec > 1.3) {
  glm_specialisti_finale <- glm.nb(S_Specialisti ~ NOME_TRATTO + NDVI, data = dataset_specialisti)
} else if (ratio_disp_spec < 0.7) {
  glm_specialisti_finale <- glm(S_Specialisti ~ NOME_TRATTO + NDVI, family = quasipoisson(link = "log"), data = dataset_specialisti)
} else {
  glm_specialisti_finale <- glm_specialisti_pois
}

