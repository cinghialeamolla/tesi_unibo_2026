# =====================================================================
# ---- GLM SULLE GUILDS: NIDIFICANTI RURALI (RURAL NESTERS) ----
# =====================================================================


# Estraggo e calcolo la ricchezza per i Rural Nesters
specie_rurali <- specie %>%
  filter(ID_SEGMENTO %in% seg_2025$ID_SEGMENTO, 
         str_squish(GUILD) == "rural nesters") %>% 
  group_by(ID_SEGMENTO, SPECIE) %>%
  summarise(CONTEGGIO_TOT = sum(CONTEGGIO), .groups = "drop")

# Trasformazione in formato WIDE
matrice_rurali <- specie_rurali %>%
  pivot_wider(names_from = SPECIE, values_from = CONTEGGIO_TOT, values_fill = 0) %>%
  column_to_rownames("ID_SEGMENTO")

# Calcolo della ricchezza della gilda rurale
indici_rurali <- tibble(
  ID_SEGMENTO = rownames(matrice_rurali),
  S_Rurali = vegan::specnumber(matrice_rurali)
)

# Unione con i metadati ambientali del 2025
dataset_rurali <- seg_2025_corretto %>%
  left_join(indici_rurali, by = "ID_SEGMENTO") %>%
  mutate(S_Rurali = replace_na(S_Rurali, 0)) # Gestione zeri impliciti

# Costruzione del modello di base (Poisson)
glm_rurali_pois <- glm(S_Rurali ~ NOME_TRATTO + NDVI,
                       family = poisson(link = "log"),
                       data = dataset_rurali)

# Controllo della dispersione
ratio_disp_rur <- glm_rurali_pois$deviance / glm_rurali_pois$df.residual
print(paste("--> RATIO DI DISPERSIONE RURALI:", round(ratio_disp_rur, 4)))

# Selezione automatica del modello in base alla dispersione
if (ratio_disp_rur > 1.3) {
  glm_rurali_finale <- glm.nb(S_Rurali ~ NOME_TRATTO + NDVI, data = dataset_rurali)
} else if (ratio_disp_rur < 0.7) {
  glm_rurali_finale <- glm(S_Rurali ~ NOME_TRATTO + NDVI, family = quasipoisson(link = "log"), data = dataset_rurali)
} else {
  glm_rurali_finale <- glm_rurali_pois
}

summary(glm_rurali_finale)

# Contrasti post-hoc con emmeans (usando i gradi di libertà reali = 74)
gl_residui_rur <- glm_rurali_finale$df.residual
medie_rurali_t <- emmeans(glm_rurali_finale, ~ NOME_TRATTO, type = "response", df = gl_residui_rur)
contrasti_rur_t <- pairs(medie_rurali_t)
print(contrasti_rur_t)

# =====================================================================
# ---- ESPORTAZIONE TABELLE IN WORD ----
# =====================================================================

# Tabella Modello
coeff_rur <- summary(glm_rurali_finale)$coefficients
df_modello_rur <- tibble(
  Parametro  = c("Intercetta (Monte)", "Tratto: Tagli", "Tratto: Valle", "NDVI (Covariata)"),
  Stima      = coeff_rur[, "Estimate"],
  Err_Std    = coeff_rur[, "Std. Error"],
  Statistica = coeff_rur[, 3], # t value o z value a seconda del modello
  p_value    = coeff_rur[, 4]
)

tab_mod_rur_word <- flextable(df_modello_rur) %>%
  set_header_labels(Parametro = "Parametro", Stima = "Stima (Coef.)", Err_Std = "Err. Std.", Statistica = "Statistica", p_value = "p-value") %>%
  colformat_double(j = c("Stima", "Err_Std", "Statistica"), digits = 3, decimal.mark = ",", big.mark = "") %>%
  colformat_double(j = "p_value", digits = 4, decimal.mark = ",", big.mark = "") %>%
  theme_booktabs() %>% autofit() %>% bold(part = "header") %>%
  flextable::align(align = "center", part = "all") %>% flextable::align(j = "Parametro", align = "left", part = "all")

