# --- FUNZIONE AUSILIARIA PER APPLICARE LO STILE APA ---
formatta_tabella <- function(df, tipo = "glm_beta") {
  ft <- flextable(df) %>% theme_booktabs() %>% autofit()
  
  if (tipo == "glm_beta") {
    ft <- ft %>%
      colformat_double(j = c("estimate", "std.error", "statistic"), digits = 3) %>%
      colformat_double(j = "p.value", digits = 4) %>%
      set_header_labels(term = "Parametro", estimate = "Stima (Coef.)", std.error = "Err. Std.", statistic = "Statistica (t/z)", p.value = "p-value")
  } else {
    ft <- ft %>%
      colformat_double(j = c("sumsq", "meansq", "statistic"), digits = 3) %>%
      colformat_double(j = "p.value", digits = 4) %>%
      set_header_labels(term = "Sorgente di Variazione", df = "Gradi Libertà (Df)", sumsq = "Somma Quadrati (SS)", meansq = "Quadrato Medio (MS)", statistic = "Valore F", p.value = "p-value")
  }
  return(ft)
}

