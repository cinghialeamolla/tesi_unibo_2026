# ==============================================================================
# ATTENZIONE!!
# se gli assunti delle ANOVA qui sopra non sono rispettati (cioè se shapiro test
# e leven test hanno p < 0.05) dobbiamo passare ai GLM che sono qui sotto
# MA
# dobbiamo fare dei GLM diversi a seconda che consideriamo ricchezza, Shannon, o Pielou
# perché
# la Ricchezza è assimilabile a un conteggio e ha distribuzione poissoniana
# Shannon si comporta di solito come una variabile normale (distribuzione gaussiana o Gamma)
# Pielou è un casino perché esprime una proporzione e ci vuole una Regressione Beta
#
# quindi qui sotto ci sono tre sezioni separate per i tre indici di diversità
# ==============================================================================

## ==============================================================================
## ---- GLM: RICCHEZZA ----
## ==============================================================================

# Modello con Tratto e NDVI come predittori - passando al GLM,
# possiamo già inserire altre variabili esplicative come l'NDVI
# Ho comunque provato a farlo
{
  glm_poisson <- glm(
    Ricchezza_S ~ NOME_TRATTO + NDVI,
    family = poisson(link = "log"),
    data = dataset_analisi_1
  )

  ### ---- VERIFICA DEGLI ASSUNTI: SOVRADISPERSIONE (Overdispersion) e SOTTODISPERSIONE (Underdispersion) -----
  # Nei dati di Poisson, la varianza dovrebbe essere uguale alla media.
  # Se la varianza è molto più alta, il modello sottostima gli errori (p-value falsamente troppo significativi).
  # Un modo rapido per controllarla è dividere la Residual Deviance per i Gradi di Libertà (Df):

  residual_deviance <- glm_poisson$deviance
  df_residual <- glm_poisson$df.residual
  ratio_dispersione <- residual_deviance / df_residual
}

cat("\nRatio di dispersione:", ratio_dispersione, "\n")
# REGOLA: Se il ratio è vicino a 1 (es. tra 0.7 e 1.3), la Poisson va bene.
# Se è decisamente > 1.3, c'è sovradispersione!
# Se è inferiore a 0.7, c'è sottodispersione (raro)

# OUTPUT - Ratio di dispersione: 0.6058564 
# Direi che siamo nel secondo caso

### ================================================================================================
### ---- SELEZIONE AUTOMATICA DEL MODELLO CHE TIENE CONTO DI EVENTUALI PROBLEMI DI DISPERSIONE -----
### ================================================================================================
{
  if (ratio_dispersione > 1.3) {
    # --- CASO A: SOVRADISPERSIONE -> NEGATIVE BINOMIAL ---
    print("--- RILEVATA SOVRADISPERSIONE: Eseguo il GLM Binomiale Negativa ---")

    glm_ricchezza_finale <- glm.nb(
      Ricchezza_S ~ NOME_TRATTO + NDVI,
      data = dataset_analisi_1
    )
  } else if (ratio_dispersione < 0.7) {
    # --- CASO B: SOTTODISPERSIONE -> QUASIPOISSON ---
    print(
      "--- RILEVATA SOTTODISPERSIONE: Uso Quasipoisson per correggere gli errori ---"
    )

    glm_ricchezza_finale <- glm(
      Ricchezza_S ~ NOME_TRATTO + NDVI,
      family = quasipoisson(link = "log"),
      data = dataset_analisi_1
    )
  } else {
    # --- CASO C: DISPERSIONE NELLA NORMA -> POISSON ---
    print(
      "--- DISPERSIONE NELLA NORMA: Procedo con il GLM Poisson classico ---"
    )
    glm_ricchezza_finale <- glm_poisson
  }
}
# OUTPUT - [1] "--- RILEVATA SOTTODISPERSIONE: Uso Quasipoisson per correggere gli errori ---"

print("--- SUMMARY DEL GLM ---")
summary(glm_ricchezza_finale)


### ================================================================================================
### ---- TEST POST-HOC PER IL GLM (Confronti a coppie tra Tratti) -----
### ================================================================================================
# Nel GLM non si usa TukeyHSD(). Usiamo il pacchetto 'emmeans' per i confronti a coppie

print("--- CONFRONTI POST-HOC TRA TRATTI (EMMEANS) ---")
# type = "response" ci restituisce i valori già trasformati dalla scala logaritmica a quella reale dei conteggi
confronti_tratti <- emmeans(
  glm_ricchezza_finale,
  specs = pairwise ~ NOME_TRATTO,
  type = "response"
)
print(confronti_tratti$contrasts)

 # OUTPUT - contrast      ratio     SE  df null z.ratio p.value
#          Monte / Tagli 1.421 0.1820 Inf    1   2.740  0.0169     # p-value < 0,05 -> differenze significative
#          Monte / Valle 1.006 0.0639 Inf    1   0.091  0.9955     # p-value > 0,05 -> differenze NON significative
#          Tagli / Valle 0.708 0.0994 Inf    1  -2.461  0.0369     # p-value < 0,05 -> differenze significative

# Il risultato riprende quanto venuto fuori dall'ANCOVA: ha senso fare anche questa?

## ==============================================================================
## ---- LM: SHANNON ----
## ==============================================================================
{
  # se gli assunti dell'anova non erano rispettati, molto probabilmente ci saranno problemi
  # anche con il GLM gaussian o gamma se non trasformiamo i dati
  # usiamo una gaussiana quindi di fatto questo è un linear model (lm)

  ### ---- Trasformazione BoxCox -----
  # faccio quindi subito una trasformazione BoxCox per raggiungere per quanto possibile la normalità
  {
    dataset_analisi_1 <- dataset_analisi_1 |>
      mutate(Shannon_H_pos = Shannon_H + 1)
    bctrans <- boxcox(
      Shannon_H_pos ~ NOME_TRATTO + NDVI,
      data = dataset_analisi_1,
      lambda = seq(0, 5, length = 10)
    )
    potenza <- bctrans$x[which(bctrans$y == max(bctrans$y))]
    dataset_analisi_1 <- dataset_analisi_1 |>
      mutate(Shannon_H_transf = Shannon_H_pos^potenza)
  }

  ### ---- Modello di regressione -----
  {
    lm_shannon <- lm(
      Shannon_H_transf ~ NOME_TRATTO + NDVI,
      data = dataset_analisi_1
    )
    par(mfrow = c(2, 2))
    plot(lm_shannon)
    par(mfrow = c(1, 1))
  }
  print("--- LM GAUSSIANO PER INDICE DI SHANNON (H') ---")
  summary(lm_shannon)
  # codice di riserva, se analizzando i dati veri vediamo che è meglio una gamma
  # {
  #   lm_shannon <- glm(
  #     Shannon_H_transf ~ NOME_TRATTO + NDVI,
  #     family = Gamma(link = "log"),
  #     data = dataset_analisi_1
  #   )
  # }

  ### ================================================================================================
  ### ---- TEST POST-HOC PER IL lLM (Confronti a coppie tra tratti) -----
  ### ================================================================================================
  posthoc_shannon <- emmeans(lm_shannon, specs = pairwise ~ NOME_TRATTO)
  print(posthoc_shannon$contrasts)
}

# Anche qui i risultati riprendono quanto emerso dalla stessa ANCOVA


## ==============================================================================
## ---- GLM: PIELOU ----
## ==============================================================================
{
  print("--- REGRESSIONE BETA PER EVENNESS DI PIELOU (J') ---")
# install.packages("betareg")
library(betareg)

  # Nota: la regressione Beta richiede che i valori siano strettamente COMPRESI tra 0 e 1.
  # Se ci sono valori esattamente uguali a 1 (es. segmenti con una sola specie dove J è non calcolabile o forzato a 1),
  # vanno rimossi o trasformati leggermente.
  
  dataset_beta <- dataset_analisi_1 %>%
    filter(Evenness_J > 0 & Evenness_J < 1)

  # Costruzione del modello Beta
  modello_beta_j <- betareg(
    Evenness_J ~ NOME_TRATTO + NDVI,
    data = dataset_beta
  )
  }
  summary(modello_beta_j)

  ### ================================================================================================
  ### ---- TEST POST-HOC PER IL GLM (Confronti a coppie tra Tratti) -----
  ### ================================================================================================
  posthoc_pielou <- emmeans(
    modello_beta_j,
    specs = pairwise ~ NOME_TRATTO,
    type = "response"
  )
  print(posthoc_pielou$contrasts)
}

# qui la parte strana è Monte - Valle p- value = 0.0554
# però è comunque sopra 0,05


