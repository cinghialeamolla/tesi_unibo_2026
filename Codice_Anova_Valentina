# 1. Esecuzione della SIMPER sulla matrice trasformata (coerente con PCoA)
# Usiamo sqrt(matrice_comunita) per non far schiacciare i risultati dalle specie iper-abbondanti
simper_risultato <- simper(sqrt(matrice_comunita), group = metadati_permanova$NOME_TRATTO, permutations = 999)

# Trasformiamo l'output in un riassunto leggibile
summary_simper <- summary(simper_risultato)

# 2. Estrazione automatica delle TOP 5 specie responsabili per ogni confronto
tabella_simper_dati <- tibble()
nomi_confronti <- names(summary_simper)

for (confronto in nomi_confronti) {
  df_comp <- as.data.frame(summary_simper[[confronto]]) %>%
    rownames_to_column(var = "Specie") %>%
    # Calcoliamo il contributo percentuale singolo e cumulativo
    mutate(
      Contrib_Percentuale = (average / sum(average)) * 100,
      Cumul_Percentuale   = cumsum(Contrib_Percentuale),
      Confronto_Tratti     = confronto
    ) %>%
    # Isoliamo le prime 5 specie con il contributo più alto
    slice_head(n = 5) %>%
    select(Confronto_Tratti, Specie, Contrib_Percentuale, Cumul_Percentuale)
  
  tabella_simper_dati <- bind_rows(tabella_simper_dati, df_comp)
}

# 3. Formattazione estetica della tabella con flextable per la tesi italiana
tabella_simper_word <- flextable(tabella_simper_dati) %>%
  set_header_labels(
    Confronto_Tratti    = "Confronto a Coppie",
