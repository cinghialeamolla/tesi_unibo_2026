# ---- CONFIGURAZIONE DIRECTORY E CARICAMENTO FORZATO DATI ----
# Definisco la cartella principale di lavoro sul PC
setwd("C:/RTesi")

# Carico i fogli Excel specificando i percorsi assoluti
specie  <- readxl::read_xlsx("C:/RTesi/dati_ombrone_corretti.xlsx", sheet = "Contatti_Specie")
segmenti <- readxl::read_xlsx("C:/RTesi/dati_ombrone_corretti.xlsx", sheet = "Segmenti")


# ---- PREPARAZIONE DEL DATASET AMBIENTALE E BIOLOGICO 2025 ----
# Isolo tutte le unità campionarie campionate nell'anno corrente 2025
seg_2025 <- segmenti %>%
  filter(ANNO == 2025)

# Filtro i contatti biologici associati esclusivamente ai segmenti del 2025
specie_2025 <- specie %>%
  filter(ID_SEGMENTO %in% seg_2025$ID_SEGMENTO) %>%
  group_by(ID_SEGMENTO, SPECIE) %>%
  # Sommo le sponde per ottenere il dato totale cumulativo del segmento
  summarise(CONTEGGIO_TOT = sum(CONTEGGIO, na.rm = TRUE), .groups = "drop")

# FORMATO WIDE: Trasformo il dataframe in una matrice "Siti x Specie" per il pacchetto vegan
matrice_comunita <- specie_2025 %>%
  pivot_wider(names_from = SPECIE, values_from = CONTEGGIO_TOT, values_fill = 0) %>%
  column_to_rownames("ID_SEGMENTO")

# CORREZIONE DATI AMBIENTALI: Forzo l'NDVI a numerico e ordiniamo i tratti in senso geografico
seg_2025_corretto <- seg_2025 %>%
  mutate(
    NDVI = as.numeric(as.character(NDVI)),
    NOME_TRATTO = factor(NOME_TRATTO, levels = c("Monte", "Tagli", "Valle"))
  ) %>%
  filter(!is.na(NDVI)) # Eliminiamo segmenti privi di dato telerilevato


# =====================================================================
# ---- TABELLA NDVI PER TRATTO (2025) ----
# =====================================================================

# Imposto i dati della tabella e ricalcolo le statistiche descrittive
tabella_ndvi_dati <- seg_2025_corretto %>%
  group_by(NOME_TRATTO) %>%
  summarise(
    Numero_Segmenti = n(),
    NDVI_Medio      = mean(NDVI),
    Deviazione_Std  = sd(NDVI),
    Minimo          = min(NDVI),
    Massimo         = max(NDVI),
    .groups = "drop"
  )

# Impagino le statistiche descrittive formattando i numeri per i sistemi italiani
tabella_completa <- flextable(tabella_ndvi_dati) %>%
  set_header_labels(
    NOME_TRATTO = "Tratto di Fiume", Numero_Segmenti = "N° Segmenti",
    NDVI_Medio = "NDVI Medio", Deviazione_Std = "Deviazione Standard",
    Minimo = "Min", Massimo = "Max"
  ) %>%
  # Arrotondo a 3 decimali impostando la virgola come separatore decimale e rimuovendo i punti delle migliaia
  colformat_double(digits = 3, decimal.mark = ",", big.mark = "") %>% 
  colformat_int(j = "Numero_Segmenti", big.mark = "") %>% 
  theme_booktabs() %>%                
  autofit() %>%                       
  bold(part = "header") %>%           
  flextable::align(align = "center", part = "all") %>% 
  flextable::align(j = "NOME_TRATTO", align = "left", part = "all")

# Salvataggio del primo documento Word (Medie Descrittive)
doc_ndvi <- read_docx() %>%
  body_add_par("Tabella 1.1: Statistiche descrittive dell'NDVI nei tre tratti monitorati (Anno 2025)", style = "heading 2") %>%
  body_add_flextable(value = tabella_completa)
print(doc_ndvi, target = "C:/RTesi/tabella_medie_ndvi_2025.docx")
print("--- TABELLA WORD GENERATA CON SUCCESSO ---")


# =====================================================================
# ---- ANOVA PER NDVI (2025) ----
# ====================================================================

# ---- VERIFICA FORMALE DEGLI ASSUNTI STATISTICI ----
# CostruSCo un modello lineare classico provvisorio per estrarre i residui da testare
anova_NDVI <- lm(NDVI ~ NOME_TRATTO, data = seg_2025_corretto)

cat("\n--- DIAGNOSTICA: VERIFICA ASSUNTI ANOVA ---\n")
# Test di Shapiro-Wilk: se p > 0.05 la distribuzione dei residui è normale
print(shapiro.test(residuals(anova_NDVI))) 

# OUTPUT
#        Shapiro-Wilk normality test
# data:  residuals(anova_NDVI)
# W = 0.98634, p-value = 0.5738

# Test di Levene: se p < 0.05 le varianze sono eterogenee (violazione dell'omoschedasticità)
print(leveneTest(NDVI ~ NOME_TRATTO, data = seg_2025_corretto))

# OUTPUT
# Levene's Test for Homogeneity of Variance (center = median)
#      Df F value   Pr(>F)   
# group  2  6.0936 0.00353 **
#      75                     

# ----  MODELLAZIONE STATISTICA AVANZATA (GLS PONDERATO) ----
# Poiché Levene è risultato significativo (p = 0.00353), applico il modello GLS.
# Uso 'weights = varIdent' per consentire ad ogni tratto di avere la propria varianza, 
# stabilizzando i residui e rendendo i p-value matematicamente inattaccabili.
gls_ndvi <- gls(NDVI ~ NOME_TRATTO, 
                data = seg_2025_corretto, 
                weights = varIdent(form = ~ 1 | NOME_TRATTO))

cat("\n--- RISULTATI OBLIGATORI: ANOVA TIPO III (GLS) ---\n")
print(car::Anova(gls_ndvi, type = "III"))

# output
# Response: NDVI
#            Df   Chisq Pr(>Chisq)     
# (Intercept)  1 5797.11  < 2.2e-16 ***
# NOME_TRATTO  2  109.87  < 2.2e-16 ***



# ---- CONTRASTI POST-HOC (TEST DI TUKEY) ED ESPORTAZIONE TABELLA  ----
# Calcoliamo i confronti a coppie corretti con il metodo di Tukey per identificare le differenze locali
confronti_posthoc <- emmeans(gls_ndvi, pairwise ~ NOME_TRATTO, adjust = "tukey")
cat("\n--- CONFRONTI A COPPIE (STIME DI TUKEY) ---\n")
print(confronti_posthoc$contrasts)

# OUTPUT
# contrast      estimate     SE   df t.ratio p.value
# Monte - Tagli  -0.0752 0.0127 44.6  -5.945 <0.0001
# Monte - Valle   0.1116 0.0167 39.9   6.680 <0.0001
# Tagli - Valle   0.1868 0.0180 46.6  10.384 <0.0001


# =====================================================================
#  -------------------- CREAZIONE TABELLA
# =====================================================================

# Trasformo i contrasti in un dataframe pulito per flextable
df_contrasti <- as.data.frame(confronti_posthoc$contrasts) %>%
  # Sostituiamo graficamente il trattino con "vs" per eleganza accademica
  mutate(contrast = gsub(" - ", " vs ", contrast))

# RISOLUZIONE DEI WARNING: Per i sistemi italiani separo le migliaia con il punto (.) e i decimali con la virgola (,)
tabella_word_contrasti <- flextable(df_contrasti) %>%
  set_header_labels(
    contrast = "Confronto Tratti", estimate = "Stima Diff. (Δ)",
    SE = "Errore Standard (SE)", df = "g.l. (Satterthwaite)",
    t.ratio = "Valore t", p.value = "p-value"
  ) %>%
  colformat_double(j = c("estimate", "SE", "df", "t.ratio"), digits = 4, decimal.mark = ",", big.mark = ".") %>%
  colformat_double(j = "p.value", digits = 4, decimal.mark = ",", na_str = "") %>%
  theme_booktabs() %>%
  autofit() %>%
  bold(part = "header") %>%
  # Evidenzio visivamente in grassetto le righe dei contrasti statisticamente significativi
  bold(i = ~ p.value < 0.05, j = c("contrast", "p.value"), part = "body") %>%
  flextable::align(align = "center", part = "all") %>%
  flextable::align(j = "contrast", align = "left", part = "all")

# Salvataggio del secondo documento Word (Tabella dei Contrasti Post-Hoc)
doc_contrasti <- read_docx() %>%
  body_add_par("Tabella 1.2: Contrasti post-hoc di Tukey (metodo GLS) per i valori di NDVI (Anno 2025)", style = "heading 2") %>%
  body_add_flextable(value = tabella_word_contrasti)
print(doc_contrasti, target = "C:/RTesi/tabella_contrasti_ndvi_2025.docx")

# =============================================================================
# ---- GRAFICO DI INTERAZIONE GENERATO DAL MODELLO (COLORBLIND-SAFE) ----
# =============================================================================

# Estraggo le medie marginali stimate dal modello GLS con i relativi intervalli di confidenza al 95%
medie_grafico <- as.data.frame(emmeans(gls_ndvi, ~ NOME_TRATTO))

# Elaborazione del grafico a linee di interazione temporale/spaziale
grafico_interazione <- ggplot(medie_grafico, aes(x = NOME_TRATTO, y = emmean, group = 1, color = NOME_TRATTO)) +
  # Disegno la linea di pendenza continua tra i tre transetti
  geom_line(linewidth = 1.2, color = "gray40", alpha = 0.6) +
  # Barre d'errore verticali che mostrano gli Intervalli di Confidenza reali (95%) stimati dal GLS
  geom_errorbar(aes(ymin = lower.CL, ymax = upper.CL), width = 0.08, linewidth = 0.8) +
  # Punti geometrici posizionati sulle medie (cerchi ad anima bianca per risaltare sullo sfondo)
  geom_point(size = 4, stroke = 1.5, fill = "white", shape = 21) +
  # PALETTE INCLUSIVA OKABE-ITO: Sostituiamo il rosso/blu con Arancione, Azzurro e Blu scuro.
  # Questo garantisce la leggibilità assoluta a lettori affetti da daltonismo.
  scale_color_manual(values = c("Monte" = "#E69F00", "Tagli" = "#56B4E9", "Valle" = "#0072B2")) +
  scale_y_continuous(limits = c(0.3, 0.7), expand = c(0, 0)) +
  labs(
    title = "Gradiente spaziale e interazione dell'NDVI Medio (Anno 2025)",
    subtitle = "Modello GLS ponderato - Intervalli di confidenza stabili al 95%",
    x = "Tratto Fluviale Monitorato",
    y = "NDVI Medio (Valori Stimati)",
    color = "Tratto di Fiume"
  ) +
  theme_classic(base_size = 14) +
  theme(
    plot.title = element_text(face = "bold", hjust = 0.5, size = 13),
    plot.subtitle = element_text(size = 10, face = "italic", hjust = 0.5, color = "gray30"),
    legend.position = "none", # Nascondiamo la legenda superflua poiché i nomi sono già sull'asse X
    axis.text = element_text(color = "black"),
    axis.title = element_text(face = "bold"),
    panel.grid.major.y = element_line(color = "gray95", linetype = "dashed")
  )

# Salvataggio grafico
ggsave("C:/RTesi/Grafico_Interazione_NDVI_2025.png", plot = grafico_interazione, width = 6.5, height = 5, dpi = 300)
