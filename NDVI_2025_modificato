
# =====================================================================
# ESTRAZIONE NDVI SU BUFFER DEI SEGMENTI REALI
# =====================================================================

library(terra)   
library(tidyverse)

# Imposto la cartella di riferimento
setwd("C:/RTesi")

# --- COEFFICIENTI DI CORREZIONE SPETTRALE (SBAF) ---
sbaf_red <- 1.0510
sbaf_nir <- 1.0058

# --- LANDSAT 8 (2013) - Pixel 30m (Riferimento Geometrico e Spettrale)
b4_2013   <- rast("16_giugno_LC08_L2SP_2013_B4.tiff") 
b5_2013   <- rast("16_giugno_LC08_L2SP_2013_B5.tiff") 
ndvi_2013 <- (b5_2013 - b4_2013) / (b5_2013 + b4_2013)


# --- SENTINEL-2 STANDARD (2025) 
b4_2025_raw <- rast("24_maggio_2025_Sentinel-2_L2A_B04_(Raw).tiff") 
b8_2025_raw <- rast("24_maggio_2025_Sentinel-2_L2A_B08_(Raw).tiff") 

# Ricampionamento spaziale e riproiezione iniziale a 30m
b4_2025_30m_raw <- project(b4_2025_raw, crs(b4_2013), res = 30, method = "bilinear")
b8_2025_30m     <- project(b8_2025_raw, crs(b4_2013), res = 30, method = "bilinear")

# Forza la banda B04 ad avere lo stesso identico Extent della B08
b4_2025_30m     <- resample(b4_2025_30m_raw, b8_2025_30m, method = "bilinear")

# Applicazione della Correzione Spettrale (SBAF) sulle singole bande
b4_2025_corr <- b4_2025_30m * sbaf_red
b8_2025_corr <- b8_2025_30m * sbaf_nir

# Calcolo dell'NDVI armonizzato 
ndvi_2025_30m <- (b8_2025_corr - b4_2025_corr) / (b8_2025_corr + b4_2025_corr)


# --- SENTINEL-2 TAGLI (2025)
b4_T2025_raw <- rast("Tagli_2025_Sentinel-2_L2A_B04_(Raw).tiff") 
b8_T2025_raw <- rast("Tagli_2025_Sentinel-2_L2A_B08_(Raw).tiff") 

# Ricampionamento spaziale e riproiezione iniziale a 30m
b4_T2025_30m_raw <- project(b4_T2025_raw, crs(b4_2013), res = 30, method = "bilinear")
b8_T2025_30m     <- project(b8_T2025_raw, crs(b4_2013), res = 30, method = "bilinear")

# Forza la banda dei Tagli B04 ad avere lo stesso identico Extent della B08
b4_T2025_30m     <- resample(b4_T2025_30m_raw, b8_T2025_30m, method = "bilinear")

# Applicazione della Correzione Spettrale (SBAF) sulle singole bande
b4_T2025_corr <- b4_T2025_30m * sbaf_red
b8_T2025_corr <- b8_T2025_30m * sbaf_nir

# Calcolo dell'NDVI armonizzato
ndvi_T2025_30m <- (b8_T2025_corr - b4_T2025_corr) / (b8_T2025_corr + b4_T2025_corr)


# --- MASCHERAMENTO ACQUA STANDARD (NDVI <= 0.1 -> NA) ---------------
ndvi_2013_veg  <- ifel(ndvi_2013 <= 0.1, NA, ndvi_2013)
ndvi_2025_veg  <- ifel(ndvi_2025_30m <= 0.1, NA, ndvi_2025_30m)
ndvi_T2025_veg <- ifel(ndvi_T2025_30m <= 0.1, NA, ndvi_T2025_30m)

# --- CARICAMENTO SHAPEFILE E GENERAZIONE BUFFER DA 50M
seg_2013_v <- vect("Tratti_2013.shp")
seg_2025_v <- vect("Tratti_2025.shp")

buf_2013 <- buffer(seg_2013_v, width = 50)
buf_2025 <- buffer(seg_2025_v, width = 50)

# --- ESTRAZIONE ANNO 2013 -----------------------
buf_2013_proj <- project(buf_2013, crs(ndvi_2013_veg))
ext_2013       <- terra::extract(ndvi_2013_veg, buf_2013_proj, fun = mean, na.rm = TRUE, exact = TRUE)

ndvi_2013_df  <- data.frame(
  ID_SEGM = buf_2013$ID_SEGM,
  NDVI    = ext_2013[, 2],
  ANNO    = 2013
)

# --- ESTRAZIONE ANNO 2025 -----------------------
# Tratti Standard (Valle e Monte)
buf_2025_standard <- buf_2025[!grepl("T3", buf_2025$ID_SEGM), ]
buf_2025_std_proj <- project(buf_2025_standard, crs(ndvi_2025_veg))
ext_2025_std      <- terra::extract(ndvi_2025_veg, buf_2025_std_proj, fun = mean, na.rm = TRUE, exact = TRUE)

df_2025_standard_finale <- data.frame(
  ID_SEGM = buf_2025_standard$ID_SEGM,
  NDVI    = ext_2025_std[, 2],
  ANNO    = 2025
)

# Tratto Tagli (T3)
buf_2025_tagli    <- buf_2025[grepl("T3", buf_2025$ID_SEGM), ]
buf_2025_tag_proj <- project(buf_2025_tagli, crs(ndvi_T2025_veg))
ext_2025_tag      <- terra::extract(ndvi_T2025_veg, buf_2025_tag_proj, fun = mean, na.rm = TRUE, exact = TRUE)

df_2025_tagli_finale <- data.frame(
  ID_SEGM = buf_2025_tagli$ID_SEGM,
  NDVI    = ext_2025_tag[, 2],
  ANNO    = 2025
)

# --- COSTRUZIONE DATASET FINALE ED ALLINEAMENTO CHIAVI RELAZIONALI ----
ndvi_totale_lineare <- bind_rows(ndvi_2013_df, df_2025_standard_finale, df_2025_tagli_finale) %>% 
  mutate(
    ID_SEGM = str_trim(ID_SEGM),
    # Forza il nome della colonna per fare il join perfetto con Excel
    ID_SEGMENTO = ID_SEGM 
  ) %>% 
  select(ID_SEGMENTO, NDVI, ANNO)

# Controllo diagnostico scientifico
totale_na <- sum(is.na(ndvi_totale_lineare$NDVI))
print(paste("--> DIAGNOSTICA: Segmenti fluviali privi di vegetazione riparia (NA):", totale_na))
if(totale_na > 0){
  print("Nota: Gli NA indicano segmenti completamente privi di vegetazione forestale (solo acqua/greto).")
}
# "--> DIAGNOSTICA: Segmenti fluviali privi di vegetazione riparia (NA): 0"

# Esportazione standard con virgola come separatore decimale e punto e virgola come separatore di campo
write.csv2(ndvi_totale_lineare, "NDVI_Finali_Segmenti_Tesi.csv", row.names = FALSE)
print("--> SUCCESS: Tabella salvata!")

