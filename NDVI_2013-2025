# Creazione dataframe e struttura tabella
dati_verticali <- data.frame(
  Anno = c("2013", "2013", "2025", "2025"),
  Tratto = c("Monte", "Valle", "Monte", "Valle"),
  N_Seg = c(28, 22, 25, 28),
  NDVI_Medio = c(0.264, 0.261, 0.526, 0.400),
  Dev_Std = c(0.030, 0.023, 0.041, 0.072),
  Variazione = c("-", "-", "+0.263", "+0.139"),
  Err_Std = c("-", "-", "0.010", "0.015"),
  t_ratio = c("-", "-", "-26.44", "-9.61"),
  p_val = c("-", "-", "<0.0001", "<0.0001")
)


# Creazione della tabella compatta con Flextable
ft_compatta <- flextable(dati_verticali) %>%
  # Arrotondamento dei decimali per le colonne numeriche reali
  colformat_double(j = c(4, 5), digits = 3) %>%
  # Rinominiamo le intestazioni delle colonne in modo chiaro e compatto
  set_header_labels(
    Anno = "Anno",
    Tratto = "Tratto",
    N_Seg = "N° Seg.",
    NDVI_Medio = "NDVI Medio",
    Dev_Std = "Dev. Std.",
    Variazione = "Diff. Netta\n(2025-2013)",
    Err_Std = "Errore Std.\n(SE)",
    t_ratio = "t-ratio",
    p_val = "p-value\n(Tukey)"
  ) %>%
  # Aggiungo una macro-intestazione superiore per separare descrittive e test
  add_header_row(
    values = c("Fattori di Analisi", "Statistiche Descrittive dell'NDVI", "Contrasti Post-Hoc GLS"),
    colwidths = c(2, 3, 4)
  ) %>%
  # Unisco graficamente le celle dell'anno per una lettura pulita
  merge_v(j = ~ Anno) %>%
  # Stile scientifico e layout
  theme_booktabs() %>%
  autofit() %>%
  # Risoluzione definitiva dei conflitti con l'allineamento
  flextable::align(align = "center", part = "all") %>%
  flextable::align(align = "left", j = 2, part = "all") %>%
  bold(j = 2, part = "body") %>%
  # Inserisco una linea orizzontale di divisione tra il blocco 2013 e il 2025
  hline(i = 2, border = fp_border(color = "gray70", width = 1))

# Creazione del file Word impostato su foglio A4 standard
doc_compatto <- read_docx() %>%
  body_add_par("Tabella X - Analisi temporale dell'NDVI (2013 vs 2025): statistiche descrittive e contrasti post-hoc derivati dal modello GLS.", style = "Normal") %>%
  body_add_flextable(ft_compatta)

# Salvataggio del file
print(doc_compatto, target = "Tabella_Compatta_GLS_NDVI.docx")
print("--> Nuova tabella Word compatta salvata come 'Tabella_Compatta_GLS_NDVI.docx'!")




