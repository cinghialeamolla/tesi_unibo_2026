# - Grafico a specchio abbondanze per i due anni: 2013 a sinistra (-) e 2025 a destra (+)
# ========================================================================================

# Carico le librerie necessarie
library(readxl)
library(ggplot2)
library(dplyr)

# Importo i dati
setwd("C:/Runibo")
dati2025 <- read_excel("C:/Runibo/dati_ornitologia_tratti_2013_2025_specchio.xlsx")

# Preparo i dati per il grafico a specchio
dati_grafico <- dati2025 %>%
  filter(Anno %in% c(2013, 2025)) %>%
  mutate(
    Anno = as.character(Anno),
    # Il 2013 diventa negativo (sinistra), il 2025 resta positivo (destra)
    Abbondanza_Grafico = ifelse(Anno == "2013", -Abbondanza, Abbondanza)
  )

# Genero il Grafico a Specchio
# NOTA: reorder(Specie, Abbondanza, FUN = sum) ordina le specie in base alla somma delle abbondanze dei due anni
grafico_specchio <- ggplot(dati_grafico, aes(x = reorder(Specie, Abbondanza, FUN = sum), y = Abbondanza_Grafico, fill = Anno)) +
  geom_bar(stat = "identity") +

coord_flip() + # Ruota il grafico in orizzontale
  scale_y_continuous(labels = abs) + # Mostra i valori di entrambi i lati come positivi
  scale_fill_manual(values = c("2025" = "#2c7bb6", "2013" = "#d7191c"),
                    labels = c("2025" = "Anno 2025", "2013" = "Anno 2013")) +
  theme_minimal() +
  labs(title = "Profilo della comunità ornitologica nidificante lungo il fiume Ombrone",
       subtitle = "Confronto della dominanza % tra il 2013 (sinistra) e il 2025 (destra) in ordine decrescente",
       x = "Specie",
       y = "Dominanza %",
       fill = "Anni a confronto") +
  theme(axis.text.y = element_text(size = 8), 
        legend.position = "bottom")

# Visualizzo e salvo il grafico
print(grafico_specchio)
ggsave("grafico_specchio_anni_ordinato.png", width = 8, height = 6, dpi = 300)





