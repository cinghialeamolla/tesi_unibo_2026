# 1. Carica forzando la colonna 2 ad essere numerica ed escludendo la terza colonna
abbondanze2025 <- read_excel("dati_ornitologia_2025.xlsx", sheet = "TOTALI") 


# 2. Controlla il risultato
head(abbondanze2025)

# 1. Classificazione delle specie in base all'abbondanza
grafico_dati <- abbondanze2025 %>%
  mutate(
    Categoria = case_when(
      Abbondanza > 5.0 ~ "Dominanti (> 5.0)",
      Abbondanza >= 2.0 & Abbondanza <= 5.0 ~ "Sub-dominanti (2.0 - 5.0)",
      Abbondanza < 2.0 ~ "Rare (< 2.0)"
    ),
    # Trasformiamo in fattore per decidere l'ordine preciso nella legenda
    Categoria = factor(Categoria, levels = c("Dominanti (> 5.0)", "Sub-dominanti (2.0 - 5.0)", "Rare (< 2.0)"))
  )

# Creazione del grafico con titolo in grassetto e asse X personalizzato
ggplot(grafico_dati, aes(x = Abbondanza, y = reorder(Specie, Abbondanza), fill = Categoria)) +
  geom_col(color = "black", width = 0.7, linewidth = 0.3) + 
  scale_fill_manual(values = c(
    "Dominanti (> 5.0)" = "#E69F00",       
    "Sub-dominanti (2.0 - 5.0)" = "#56B4E9", 
    "Rare (< 2.0)" = "#F0E442"       
  )) +
  scale_x_continuous(breaks = seq(0, 16, by = 2)) + 
  labs(
    title = "Dominanza % (2025)",
    fill = "Classi di Dominanza",
    x = NULL,  
    y = NULL   
  ) +
  theme_minimal(base_size = 12) + 
  theme(
    plot.title = element_text(face = "bold", size = 14), # Titolo in grassetto e leggermente più grande
    panel.grid.minor = element_blank(),
    legend.position = "bottom",    
    axis.text.y = element_text(face = "italic") 
  )

# Salva il grafico appena generato nella tua cartella di lavoro
ggsave(
  filename = "grafico_dominanza_2025.png", # Nome del file e formato (.png o .pdf)
  width = 20,                              # Larghezza in cm
  height = 30,                             # Altezza in cm (aumentala se hai moltissime specie)
  units = "cm",                            # Unità di misura per larghezza e altezza
