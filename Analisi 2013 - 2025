# =====================================================================
#  ANALISI MULTIVARIATA DI COMUNITÀ (PERMANOVA)
# =====================================================================

# Creo la matrice di comunità (Siti x Specie) standardizzata per lo sforzo
# Per confrontare i siti uso l'abbondanza standardizzata (individui per 100m)
matrice_comunita_seg <- specie %>%
  inner_join(seg_storici, by = "ID_SEGMENTO") %>%
  mutate(Abbondanza_100m = (CONTEGGIO / LUNGHEZZA_m) * 100) %>%
  group_by(ID_SEGMENTO, SPECIE) %>%
  summarise(Abbondanza_100m = sum(Abbondanza_100m), .groups = "drop") %>%
  pivot_wider(names_from = SPECIE, values_from = Abbondanza_100m, values_fill = 0)

# Separo i dati biologici (matrice numerica) dai fattori ambientali
matrice_numerica <- matrice_comunita_seg %>% 
  column_to_rownames("ID_SEGMENTO")

fattori_ambientali <- seg_storici %>%
  filter(ID_SEGMENTO %in% rownames(matrice_numerica)) %>%
  arrange(match(ID_SEGMENTO, rownames(matrice_numerica)))

# Esecuzione della PERMANOVA (999 permutazioni)
# Verifica se la composizione della comunità differisce significativamente per l'interazione
permanova_comunita <- adonis2(matrice_numerica ~ ANNO * NOME_TRATTO, 
                             data = fattori_ambientali, 
                             method = "bray", 
                             by = "terms",      # Forza la separazione di Anno, Tratto e Interazione
                             permutations = 999)

cat("\n--- TABELLA DETTAGLIATA DELLA PERMANOVA ---\n")
print(permanova_comunita)

# OUTPUT
#                  Df SumOfSqs      R2       F Pr(>F)    
# ANNO               1   2.8529 0.11242 13.7959  0.001 ***
# NOME_TRATTO        1   1.5475 0.06098  7.4835  0.001 ***
# ANNO:NOME_TRATTO   1   0.5034 0.01984  2.4344  0.004 ** 
# Residual          99  20.4724 0.80676                   
# Total            102  25.3762 1.00000    


# =====================================================================
# ESPORTAZIONE TABELLA PERMANOVA IN FORMATO WORD
# =====================================================================

#  Trasformo l'output in un dataframe pulito
permanova_df <- as.data.frame(permanova_comunita) %>%
  rownames_to_column(var = "Sorgente_Varianza") %>%
  mutate(
    Sorgente_Varianza = case_when(
      Sorgente_Varianza == "ANNO" ~ "Anno (2013 vs 2025)",
      Sorgente_Varianza == "NOME_TRATTO" ~ "Tratto Fluviale (Monte vs Valle)",
      Sorgente_Varianza == "ANNO:NOME_TRATTO" ~ "Interazione Anno x Tratto",
      Sorgente_Varianza == "Residual" ~ "Residuo",
      Sorgente_Varianza == "Total" ~ "Totale",
      TRUE ~ Sorgente_Varianza
    )
  )

# Creazione della tabella formattata con flextable
tabella_permanova_word <- flextable(permanova_df) %>%
  set_header_labels(
    Sorgente_Varianza = "Sorgente di Varianza",
    Df = "Df",
    SumOfSqs = "Somma dei Quadrati",
    R2 = "R²",
    F = "F di Snedecor",
    `Pr(>F)` = "p-value"
  ) %>%
  # Formattazione decimali
  colformat_double(j = "SumOfSqs", digits = 3) %>%
  colformat_double(j = "R2", digits = 4) %>%
  colformat_double(j = "F", digits = 3) %>%
  colformat_double(j = "Pr(>F)", digits = 3) %>%
  # Evidenzio in grassetto le righe significative
  bold(i = ~ `Pr(>F)` <= 0.05, part = "body") %>%
  align(align = "center", part = "all") %>%
  align(j = "Sorgente_Varianza", align = "left", part = "all") %>%
  theme_booktabs() %>%
  autofit()

# Scrittura del file Word
doc_perm <- read_docx() %>%
  body_add_par("Tabella XX - Risultati dell'analisi della varianza multivariata permutazionale (PERMANOVA) basata su distanze di Bray-Curtis.", style = "Normal") %>%
  body_add_flextable(tabella_permanova_word)

print(doc_perm, target = "C:/RTesi/Tabella_PERMANOVA_Comunita.docx")
print("--> SUCCESS: Tabella PERMANOVA salvata correttamente in Word!")

# =====================================================================
# BLOCCO 2: ANALISI DEL TURNOVER DELLA COMUNITÀ (INDICE DI JACCARD)
# =====================================================================


# 1. Estraiamo la lista delle sole specie realmente contattate nei due periodi storici
specie_2013_unique <- specie %>%
  inner_join(filter(segmenti, ANNO == 2013 & NOME_TRATTO %in% tratti_storici), by = "ID_SEGMENTO") %>%
  pull(SPECIE) %>% unique()

specie_2025_unique <- specie %>%
  inner_join(filter(segmenti, ANNO == 2025 & NOME_TRATTO %in% tratti_storici), by = "ID_SEGMENTO") %>%
  pull(SPECIE) %>% unique()

# 2. Computazione degli elementi matematici dell'Indice di Jaccard
comuni <- intersect(specie_2013_unique, specie_2025_unique) # Intersezione (A ∩ B)
perse  <- setdiff(specie_2013_unique, specie_2025_unique)   # Esclusive 2013 (Estinte localmente)
nuove  <- setdiff(specie_2025_unique, specie_2013_unique)   # Esclusive 2025 (Nuove colonizzazioni)

# Formule classiche della diversità Beta
jaccard_sim <- length(comuni) / length(union(specie_2013_unique, specie_2025_unique))
turnover    <- 1 - jaccard_sim

# 3. Strutturazione del Dataframe riassuntivo per la tesi
tabella_jaccard <- data.frame(
  Metrica = c("Similarità di Jaccard (Condivisione specie)", 
              "Turnover di Jaccard (Dissimilarità temporale)", 
              "Pool Specie Totali - Anno 2013", 
              "Pool Specie Totali - Anno 2025", 
              "Specie storiche non ricontattate (Perse)", 
              "Nuove specie campionate nel 2025 (Acquisite)"),
  Valore = c(round(jaccard_sim, 3), 
             round(turnover, 3), 
             length(specie_2013_unique), 
             length(specie_2025_unique), 
             length(perse), 
             length(nuove))
)

# 4. Formattazione accademica elegante con flextable per Word
tab_finale <- flextable(tabella_jaccard) %>%
  set_header_labels(Metrica = "Parametro Ecologico di Diversità Beta", Valore = "Valore") %>%
  theme_vanilla() %>%
  bold(part = "header") %>%
  align(j = "Valore", align = "center", part = "all") %>%
  autofit()

# Mostra l'anteprima visiva della tabella in RStudio
tab_finale

