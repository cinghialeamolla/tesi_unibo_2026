segmenti <- readxl::read_xlsx("dati_ombrone_provvisori.xlsx", sheet = "Segmenti")

# Definisco i soli due tratti presenti in ENTRAMBI gli anni per il confronto
tratti_confronto <- c("Monte", "Valle")


# ---AGGREGAZIONE PULITA PER IL 2025 ------------------------------
# Isolo prima i segmenti del solo 2025 e dei soli due tratti storici
seg_2025 <- segmenti %>% 
  filter(ANNO == 2025 & NOME_TRATTO %in% tratti_confronto)

dati_agg_2025 <- specie_2025 %>%
  # inner_join tiene SOLO i contatti che appartengono ai segmenti del 2025
  inner_join(seg_2025, by = "ID_SEGMENTO") %>% 
   # Aggrego per NOME_TRATTO
  group_by(NOME_TRATTO) %>%
  summarise(
   # Somma totale degli individui
    Conteggio_Tot       = sum(CONTEGGIO, na.rm = TRUE),
   # Ricchezza totale (n° specie uniche viste in tutto il tratto)
    Ricchezza_S         = n_distinct(SPECIE),
    # Calcolo della lunghezza reale (senza duplicazioni)
    Lunghezza_Totale_m  = sum(LUNGHEZZA_m[!duplicated (ID_SEGMENTO)], na.rm = TRUE),
   # Elenco delle specie presenti (utile per il turnover di Jaccard)
    Lista_Specie        = paste(sort(unique(SPECIE)), collapse = ", "),
    .groups = "drop"
  ) %>%
  mutate(ANNO = 2025)


