## ---- glm ----
glm_storico <- glm(Ricchezza_S ~ NOME_TRATTO * as.factor(ANNO) + offset(log(Lunghezza_Totale_m)), 
                   family = poisson(link = "log"), # o quasi-poisson
                   data = dataset_storico)

# Verifica la dispersione (se > 1.3, usa quasipoisson)
