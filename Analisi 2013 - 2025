# =====================================================================
# BLOCCO 1: GLM UNIVARIATO SULLA RICCHEZZA DEI SEGMENTI (T1 & T2)
# =====================================================================

# Isolo i segmenti storici puri (T1 e T2) per entrambi gli anni
tratti_storici <- c("Monte", "Valle")

seg_storici <- segmenti %>%
  filter(NOME_TRATTO %in% tratti_storici) %>%
  mutate(
    ANNO = factor(ANNO, levels = c("2013", "2025")),
    NOME_TRATTO = factor(NOME_TRATTO, levels = c("Monte", "Valle"))
  )

# Calcolo la Ricchezza Specifica (S) per ogni singolo segmento
ricchezza_singoli_seg <- specie %>%
# Aggancio le info dei segmenti (serve per avere NOME_TRATTO e LUNGHEZZA_m)
  inner_join(seg_storici, by = "ID_SEGMENTO") %>%
# 2. Aggrego per NOME_TRATTO
  group_by(ID_SEGMENTO) %>%
  summarise(Ricchezza_S = n_distinct(SPECIE), .groups = "drop")

# Unisco i dati biologici a quelli geografici e ambientali
dati_glm_storici <- seg_storici %>%
  left_join(ricchezza_singoli_seg, by = "ID_SEGMENTO") %>%
  mutate(Ricchezza_S = replace_na(Ricchezza_S, 0)) # Gestione eventuali zeri  


# Costruisco il modello GLM Quasi-Poisson con Offset della lunghezza
glm_ricchezza <- glm(Ricchezza_S ~ ANNO * NOME_TRATTO, 
                      family = quasipoisson(link = "log"), 
                      offset = log(LUNGHEZZA_m), 
                      data = dati_glm_storici)
glm_ricchezza
# output
#               (Intercept)                   ANNO2025           NOME_TRATTOValle  ANNO2025:NOME_TRATTOValle  
#                  -3.3717                     0.5681                    -0.3641                     0.2552  

# Degrees of Freedom: 102 Total (i.e. Null);  99 Residual
# Null Deviance:      216 
# Residual Deviance: 97.53        AIC: NA



# Test dei fattori globali con ANOVA di Tipo III 
cat("\n--- ANOVA TIPO III SULLA RICCHEZZA SPECIFICA ---\n")
print(car::Anova(glm_ricchezza, type = "III"))

# OUTPUT
# Response: Ricchezza_S
#                 LR Chisq Df Pr(>Chisq)    
# ANNO               39.157  1  3.911e-10 ***
# NOME_TRATTO        11.093  1  0.0008666 ***
# ANNO:NOME_TRATTO    3.645  1  0.0562345 .  
# Signif. codes:  0 ‘***’ 0.001 ‘**’ 0.01 ‘*’ 0.05 ‘.’ 0.1 ‘ ’ 1


# Contrasti Post-Hoc per analizzare le dinamiche temporali nei due tratti
medie_em <- emmeans(glm_ricchezza, ~ ANNO | NOME_TRATTO, type = "response")
contrasti_temporali <- pairs(medie_em, reverse = TRUE)

cat("\n--- CONTRASTI TEMPORALI POST-HOC (2025 vs 2013) ---\n")
print(summary(contrasti_temporali, adjust = "tukey"))

# NOME_TRATTO = Monte:
 # contrast            ratio    SE  df null z.ratio p.value
