       y = "Numero di specie (media predetta)",
       x = "Tratto e Anno")


## ---- analisi turnover con Jaccard ----
# Calcoliamo gli elementi base per l'Indice di Jaccard
specie_2013 <- unique(specie_2013$SPECIE)
specie_2025 <- unique(specie_2025$SPECIE)

comuni <- intersect(specie_2013, specie_2025)
perse  <- setdiff(specie_2013, specie_2025)    # Presenti nel 2013, non nel 2025
nuove  <- setdiff(specie_2025, specie_2013)    # Presenti nel 2025, non nel 2013

jaccard_sim <- length(comuni) / length(union(specie_2013, specie_2025))
turnover    <- 1 - jaccard_sim

# 2. Creiamo un dataframe ordinato per la tabella
tabella_jaccard <- data.frame(
  Metrica = c("Similarità di Jaccard", 
              "Turnover (Dissimilarità)", 
              "Specie totali (2013)", 
              "Specie totali (2025)", 
              "Specie perse", 
              "Specie nuove acquisite"),
  Valore = c(round(jaccard_sim, 3), 
             round(turnover, 3), 
             length(specie_2013), 
             length(specie_2025), 
             length(perse), 
             length(nuove))
)

# 3. Formattazione professionale con flextable
library(flextable)
tab_finale <- flextable(tabella_jaccard) %>%
  set_header_labels(Metrica = "Parametro Ecologico", Valore = "Valore") %>%
  theme_vanilla() %>%
  bold(part = "header") %>%
  autofit()
tab_finale
