## ---- load data ----
{
  specie_2025 <- readxl::read_xlsx(
    "data/dati_ombrone_provvisori.xlsx", 
    sheet = "Contatti_Specie" # occhio al nome del foglio di lavoro
  )
  segmenti <- readxl::read_xlsx(
    "data/dati_ombrone_provvisori.xlsx", 
    sheet = "Segmenti" 
  )
}

# Supponiamo di partire dal dataset che contiene i contatti e le info sui segmenti
# (quello che avete chiamato 'contatti_all' o simile)


## ---- aggregazione dei dati per il 2025 ----
dati_aggregati_2025 <- specie_2025 %>%
  # 1. Agganciamo le info dei segmenti (serve per avere NOME_TRATTO e LUNGHEZZA_m)
  left_join(segmenti, by = "ID_SEGMENTO") %>%
  # 2. Aggreghiamo per NOME_TRATTO
  group_by(NOME_TRATTO) %>%
  summarise(
    # Somma totale degli individui
    Conteggio_Tot = sum(CONTEGGIO, na.rm = TRUE),
    # Ricchezza totale (n° specie uniche viste in tutto il tratto)
    Ricchezza_S = n_distinct(SPECIE),
    # Lunghezza totale del tratto (somma delle lunghezze dei segmenti)
    Lunghezza_Totale_m = sum(LUNGHEZZA_m, na.rm = TRUE),
    # Elenco delle specie presenti (utile per il turnover di Jaccard)
    Lista_Specie = paste(unique(SPECIE), collapse = ", "),
    .groups = "drop"
  ) %>%
  mutate(ANNO = 2025)

# Visualizziamo il risultato
print(dati_aggregati_2025)


