# =====================================================================
# CALCOLO INDICE DI PIELOU E MODELLO STATISTICO GLS
# =====================================================================

# Filtro i segmenti dei soli tratti storici (Monte e Valle)
seg_storici_completi <- segmenti %>% 
  filter(NOME_TRATTO %in% c("Monte", "Valle"))

# Creo la matrice comunitaria dove OGNI RIGA è un ID_SEGMENTO unico
matrice_comunita_segmenti <- specie %>%
  filter(ID_SEGMENTO %in% seg_storici_completi$ID_SEGMENTO) %>%
  group_by(ID_SEGMENTO, SPECIE) %>%
  summarise(Conteggio = sum(CONTEGGIO, na.rm = TRUE), .groups = "drop") %>%
  pivot_wider(names_from = SPECIE, values_from = Conteggio, values_fill = 0)

# Isolo la parte puramente numerica delle specie per i calcoli ecologici
matrice_pura_seg <- matrice_comunita_segmenti %>% 
  dplyr::select(-ID_SEGMENTO)

# Arrotondo per eliminare eventuali decimali latenti che bloccano le funzioni biologiche
matrice_interi_seg <- round(matrice_pura_seg)

# Estraggo i metadati ambientali ordinati esattamente come le righe della matrice
metadati_segmenti <- data.frame(ID_SEGMENTO = matrice_comunita_segmenti$ID_SEGMENTO) %>%
  left_join(segmenti, by = "ID_SEGMENTO")

# Riparto dalla matrice comunitaria PURA per singolo segmento (matrice_interi_seg)
# e dal dataframe dei metadati/ambientali dei segmenti (metadati_segmenti)

# CALCOLO DI PIELOU (J)
# Pielou = Shannon (H) / log(Ricchezza S)
shannon_seg   <- vegan::diversity(matrice_interi_seg, index = "shannon")
ricchezza_seg <- vegan::specnumber(matrice_interi_seg)
pielou_seg    <- shannon_seg / log(ricchezza_seg)

# Gestisco eventuali segmenti con 0 o 1 sola specie 
pielou_seg[ricchezza_seg <= 1] <- 0

# AGGIORNAMENTO DEL DATASET AMBIENTALE
dati_statistica_seg <- metadati_segmenti %>%
  mutate(
    Pielou = pielou_seg,
    ANNO   = factor(ANNO),
    NOME_TRATTO = factor(NOME_TRATTO),
    NDVI   = as.numeric(NDVI)
  ) %>%
  filter(!is.na(Pielou) & ricchezza_seg > 1) # Escludo i segmenti non analizzabili

# =====================================================================
# MODELLO 1: EFFETTO DELL'NDVI (La biomassa forestale guida l'equiripartizione?)
# =====================================================================
# Usiamo il GLS permettendo alla varianza di cambiare tra gli anni e i tratti
gls_pielou_ndvi <- gls(Pielou ~ NDVI * NOME_TRATTO, 
                       data = dati_statistica_seg,
                       weights = varIdent(form = ~ 1 | ANNO * NOME_TRATTO),
                       na.action = na.omit)

shapiro.test(residuals(gls_pielou_ndvi)) # p-value = 4.624e-11, è inferiore a 0,05, i residui NON sono normali

levene_j <- leveneTest(Pielou ~ NOME_TRATTO, data = dati_statistica_seg)
print(levene_j) # p-value=  0.3154 > p-vaue 0,05; le varianze sono omogenee

# passo alla regressione beta

# La regressione Beta non accetta valori esattamente uguali a 0 o 1.
# Applico una correzione standard di Smithson & Verkuilen se ci sono estremi.
dati_statistica_seg <- dati_statistica_seg %>%
  mutate(Pielou_Corr = (Pielou * (n() - 1) + 0.5) / n())

# Modello Beta con interazione per l'NDVI
mod_beta_ndvi <- betareg(Pielou_Corr ~ NDVI * NOME_TRATTO, data = dati_statistica_seg)

# Visualizzazione dei risultati tramite il summary standard (Inattaccabile)
print("--- SUMMARY DETTAGLIATO DEL MODELLO BETA NDVI ---")
print(summary(mod_beta_ndvi))

# Contrasti post-hoc temporali estratti in modo pulito con emmeans
print("--- CONTRASTI POST-HOC NDVI (REGRESSIONE BETA) ---")



trend_ndvi <- emtrends(mod_beta_ndvi, ~ NOME_TRATTO, var = "NDVI", type = "response")
print("--- PENDENZE REALI (TREND) DELLA RELAZIONE PIELOU ~ NDVI ---")
print(trend_ndvi)


