#   IMPOSTAZIONE CARTELLA E CARICAMENTO FORZATO DEI DATI
setwd("C:/RTesi")

# CARICAMENTO DATI ORIGINALI
# Carico i fogli originali specificando esplicitamente il pacchetto readxl
# per evitare conflitti con la funzione omonima presente in 'officer'
specie  <- readxl::read_xlsx("dati_ombrone_provvisori.xlsx", sheet = "Contatti_Specie")
segmenti <- readxl::read_xlsx("dati_ombrone_provvisori.xlsx", sheet = "Segmenti")

# Definisco i due tratti storici presenti in entrambi gli anni
tratti_confronto <- c("Monte", "Valle")

# ---- ISOLAMENTO E PULIZIA DEI SEGMENTI AMBIENTALI ----
# Isolo i segmenti per il 2025 (escludendo il tratto dei Tagli e tenendo solo Monte/Valle)
seg_2025_solo <- segmenti %>% 
  filter(ANNO == 2025 & NOME_TRATTO %in% tratti_confronto)

# Isolo i segmenti per il 2013 per i tratti storici corrispondenti
seg_2013_solo <- segmenti %>% 
  filter(ANNO == 2013 & NOME_TRATTO %in% tratti_confronto)


# ---- CALCOLO DELLA LUNGHEZZA REALE DEI TRANSETTI ----
# Sommo la lunghezza dei segmenti una sola volta per ciascun tratto.
# Questo previene la macro-sottostima causata dai filtri duplicati durante i join successivi.
lunghezze_2025 <- seg_2025_solo %>%
  group_by(NOME_TRATTO) %>%
  summarise(Lunghezza_Totale_m = sum(LUNGHEZZA_m, na.rm = TRUE), .groups = "drop")

lunghezze_2013 <- seg_2013_solo %>%
  group_by(NOME_TRATTO) %>%
  summarise(Lunghezza_Totale_m = sum(LUNGHEZZA_m, na.rm = TRUE), .groups = "drop")


# ---- AGGREGAZIONE BIOLOGICA DEI CONTEGGI PER IL 2025 ----
dati_agg_2025 <- specie %>%
  # inner_join trattiene solo i contatti di uccelli registrati nei segmenti del 2025 selezionati
  inner_join(seg_2025_solo, by = "ID_SEGMENTO") %>% 
  group_by(NOME_TRATTO) %>%
  summarise(
    Conteggio_Tot = sum(CONTEGGIO, na.rm = TRUE), # Somma degli individui totali
    Ricchezza_S   = n_distinct(SPECIE),          # Numero di specie uniche osservate
    Lista_Specie  = paste(sort(unique(SPECIE)), collapse = ", "), # Stringa elenco specie
    .groups = "drop"
  ) %>%
  # Aggancio la lunghezza totale reale calcolata al punto 4
  left_join(lunghezze_2025, by = "NOME_TRATTO") %>% 
  mutate(ANNO = 2025)


# ---- AGGREGAZIONE BIOLOGICA DEI CONTEGGI PER IL 2013 ----
dati_agg_2013 <- specie %>% 
  # inner_join trattiene solo i contatti di uccelli registrati nei segmenti del 2013 selezionati
  inner_join(seg_2013_solo, by = "ID_SEGMENTO") %>% 
  group_by(NOME_TRATTO) %>%
  summarise(
    Conteggio_Tot = sum(CONTEGGIO, na.rm = TRUE), 
    Ricchezza_S   = n_distinct(SPECIE),          
    Lista_Specie  = paste(sort(unique(SPECIE)), collapse = ", "), 
    .groups = "drop"
  ) %>%
  # Aggancio la lunghezza totale reale calcolata al punto 4
  left_join(lunghezze_2013, by = "NOME_TRATTO") %>% 
  mutate(ANNO = 2013)


# ---- COSTRUZIONE DELLA MATRICE SITI X SPECIE PER VEGAN ----
# Unisco temporaneamente i dati per generare la matrice a formato largo (pivot) 
# necessaria alle funzioni ecologiche del pacchetto 'vegan'
dati_ornitici_completi <- specie %>%
  inner_join(bind_rows(seg_2013_solo, seg_2025_solo), by = "ID_SEGMENTO")

matrice_comunita_tratti <- dati_ornitici_completi %>%
  group_by(ANNO, NOME_TRATTO, SPECIE) %>%
  summarise(Conteggio = sum(CONTEGGIO, na.rm = TRUE), .groups = "drop") %>%
  pivot_wider(names_from = SPECIE, values_from = Conteggio, values_fill = 0)

# Isolo la matrice puramente numerica (rimuovendo i fattori di raggruppamento)
# Uso esplicitamente dplyr::select per evitare i conflitti distruttivi con il pacchetto MASS
matrice_pura_tratti <- matrice_comunita_tratti %>% 
  dplyr::select(-ANNO, -NOME_TRATTO)

# RISOLUZIONE BLOCCO RAREFY: Arrotondo all'intero più vicino per eliminare i decimali latenti
matrice_interi <- round(matrice_pura_tratti)


# ---- FUSIONE FINALE E CALCOLO DELLE METRICHE SCIENTIFICHE STANDARD ----
# Unisco i due blocchi storici di dati aggregati
dataset_storico <- bind_rows(dati_agg_2013, dati_agg_2025) %>%
  arrange(NOME_TRATTO, ANNO)

# Identifico il numero minimo di individui tra i 4 macro-pool per impostare 
# il livello di sussistenza della rarificazione (risulterà pari a 176 individui a Monte 2013)
min_individui_pool <- min(rowSums(matrice_interi)) 

# Calcolo gli indici standardizzando correttamente l'effort
dataset_storico_scientifico <- dataset_storico %>%
  mutate(
    # L'abbondanza (individui totali) standardizzata in modo LINEARE su 100 metri
    Densita_Linear_100m = (Conteggio_Tot / Lunghezza_Totale_m) * 100,
    
    # La ricchezza (S) NON è lineare: si standardizza calcolando la Ricchezza Rarificata attesa E(S)
    # basata sull'omogeneizzazione del numero di contatti (sample = 176)
    Ricchezza_Rarificata_ES = vegan::rarefy(matrice_interi, sample = min_individui_pool),
    
    # Calcolo l'Indice di diversità alpha di Shannon-Wiener per la struttura della comunità
    Shannon_H = vegan::diversity(matrice_interi, index = "shannon"),
    
    ANNO = factor(ANNO)
  ) %>%
  # Seleziono e ordino le colonne finali pulite per la visualizzazione, escludendo la lista testuale delle specie
  dplyr::select(ANNO, NOME_TRATTO, Lunghezza_Totale_m, Conteggio_Tot, Ricchezza_S, Densita_Linear_100m, Ricchezza_Rarificata_ES, Shannon_H)


# ---- STAMPA DIAGNOSTICA FINALE A SCHERMO ----
print("--- DATI ECOLOGICI FINALI CORRETTI E STANDARDIZZATI (STILE PAPER) ---")
print(dataset_storico_scientifico)



