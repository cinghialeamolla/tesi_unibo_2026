# ----  CARICAMENTO LIBRERIE ----

library(tidyverse) # Include 'dplyr' (gestione tabelle), 'tidyr' (strutturazione), 'ggplot2' (grafici)
library(readxl)    # Caricamento di file Excel (.xlsx)
library(vegan)     # Pacchetto standard per indici di diversità, rarificazione e analisi multivariate
library(nlme)      # Modelli GLS (Generalized Least Squares) essenziali per gestire le varianze diverse tra gli anni 
library(car)       # Per eseguire l'ANOVA di Tipo III sui modelli complessi (funzione Anova)
library(emmeans)   # Gestione dei contrasti post-hoc (es. test di Tukey) dopo i modelli statistici
library(flextable) # Consente di trasformare le tabelle di R in tabelle eleganti per pubblicazioni scientifiche
library(officer)   # Permette ad R di scrivere e salvare direttamente file in formato Microsoft Word (.docx)

library(MASS) # per glm.nb()
library(betareg)  # per Regressione beta


#   IMPOSTAZIONE CARTELLA E CARICAMENTO FORZATO DEI DATI
setwd("C:/RTesi")

# CARICAMENTO DATI ORIGINALI
# Carico i fogli originali specificando i percorsi espliciti
# per evitare conflitti con la funzione omonima presente in 'officer'
specie  <- readxl::read_xlsx("dati_ombrone_provvisori.xlsx", sheet = "Contatti_Specie")
segmenti <- readxl::read_xlsx("dati_ombrone_provvisori.xlsx", sheet = "Segmenti")

# Definisco i due tratti storici presenti in entrambi gli anni
tratti_confronto <- c("Monte", "Valle")

# ---- ISOLAMENTO E PULIZIA DEI SEGMENTI AMBIENTALI ----
# Isolo i segmenti per il 2025 (escludendo il tratto dei Tagli e tenendo solo Monte/Valle)
seg_ambientali_storici <- segmenti %>% 
  filter(NOME_TRATTO %in% tratti_confronto) %>%
  mutate(ANNO = as.factor(ANNO), NOME_TRATTO = as.factor(NOME_TRATTO))

# Calcolo lo sforzo spaziale totale (lunghezza complessiva in metri) per Anno e Tratto.
# Questo passaggio evita la macro-sottostima o duplicazione dei dati nei join biologici.
lunghezze_tratti <- seg_ambientali_storici %>%
  group_by(ANNO, NOME_TRATTO) %>%
  summarise(Lunghezza_Totale_m = sum(LUNGHEZZA_m, na.rm = TRUE), .groups = "drop")

# ----- AGGREGAZIONE DATI BIOLOGICI (CONTEGGI E RICCHEZZA) ----
# Uniamo le osservazioni biologiche ai soli segmenti dei tratti storici
dati_ornitici_storici <- specie %>%
 # inner_join trattiene solo i contatti di uccelli registrati nei segmenti del 2025 selezionati
  inner_join(seg_ambientali_storici, by = "ID_SEGMENTO")

# Aggrego i contatti a livello di macro-pool (Anno x Tratto)
dati_biologici_aggregati <- dati_ornitici_storici %>%
  group_by(ANNO, NOME_TRATTO) %>%
  summarise(
    Contatti_Totali_N = sum(CONTEGGIO, na.rm = TRUE),
    Ricchezza_Osservata_S = n_distinct(SPECIE),
    .groups = "drop"
  ) %>%
  # Riconverto l'anno in fattore per garantire l'unione corretta
  mutate(ANNO = as.factor(ANNO)) %>%
  # Aggancio lo sforzo spaziale precedentemente calcolato
  left_join(lunghezze_tratti, by = c("ANNO", "NOME_TRATTO"))

# Generiamo la matrice in formato "largo" (Pivot) richiesta dalle metriche ecologiche
matrice_comunita_tratti <- dati_ornitici_storici %>%
  group_by(ANNO, NOME_TRATTO, SPECIE) %>%
  summarise(Conteggio = sum(CONTEGGIO, na.rm = TRUE), .groups = "drop") %>%
  pivot_wider(names_from = SPECIE, values_from = Conteggio, values_fill = 0)

# Isoliamo la sola matrice numerica eliminando le colonne di testo
# Usiamo dplyr::select in modo esplicito per evitare il blocco generato dal pacchetto MASS
matrice_pura <- matrice_comunita_tratti %>% 
  dplyr::select(-ANNO, -NOME_TRATTO)

# Arrotondiamo i valori all'intero più vicino per superare il blocco degli algoritmi combinatori di rarefy
matrice_interi <- round(matrice_pura)


# ---- CALCOLO METRICHE SCIENTIFICHE (BIODIVERSITÀ E COMPILAZIONE TABELLA ) ----
# Identifico il livello minimo di sussistenza campionaria (pari a 176 individui di Monte 2013)
min_individui_pool <- min(rowSums(matrice_interi))

# Calcolo in blocco gli indici ecologici direttamente sulla matrice strutturata
vettore_rarificazione <- vegan::rarefy(matrice_interi, sample = min_individui_pool)
vettore_shannon       <- vegan::diversity(matrice_interi, index = "shannon")

# Costruisco il dataframe temporaneo degli indici biologici complessi
indici_ecologici_df <- matrice_comunita_tratti %>%
  dplyr::select(ANNO, NOME_TRATTO) %>%
  mutate(
    Ricchezza_Rarificata_ES = vettore_rarificazione,
    Diversita_Shannon_H     = vettore_shannon
  ) %>%
  mutate(ANNO = as.factor(ANNO))

# Unisco tutte le informazioni e calcoliamo i parametri lineari standardizzati
Tabella_xx_Finale <- dati_biologici_aggregati %>%
  left_join(indici_ecologici_df, by = c("ANNO", "NOME_TRATTO")) %>%
  mutate(
    # Calcolo della densità lineare standardizzata su base 100 metri
    Densita_Lineare_100m = (Contatti_Totali_N / Lunghezza_Totale_m) * 100
  ) %>%
  # Ordino l'output finale in modo logico e speculare alla tesi
  arrange(ANNO, NOME_TRATTO) %>%
  dplyr::select(
    Anno = ANNO,
    Tratto = NOME_TRATTO,
    `Sforzo Spaziale (m)` = Lunghezza_Totale_m,
    `Contatti Totali (N)` = Contatti_Totali_N,
    `Ricchezza Osservata (S)` = Ricchezza_Osservata_S,
    `Densità Lineare (ind. / 100 m)` = Densita_Lineare_100m,
    `Ricchezza Rarificata E(S)` = Ricchezza_Rarificata_ES,
    `Diversità di Shannon (H')` = Diversita_Shannon_H
  )

# ---- STAMPA DIAGNOSTICA FINALE A SCHERMO ----
print("--- DATI ECOLOGICI FINALI CORRETTI E STANDARDIZZATI (STILE PAPER) ---")
print(Tabella_xx_Finale)

