# ---- ESTRAZIONE NDVI BUFFER 100M ----
# =====================================================================

# Carico i raster
ndvi_2013 <- rast("ndvi_ombrone_2013.tif")
ndvi_2025 <- rast("ndvi_ombrone_2025.tif")

# Carico il file.csv con le coordinate geografiche
dati_punti <- read.csv("punti.csv", sep = ";", dec = ",")
punti_geo  <- vect(dati_punti, geom = c("est", "nord"), crs = "EPSG:32632")

# Devo eliminare i pixel di acqua (Sotto lo 0.1 è acqua/suolo nudo umido)
ndvi_2013_veg <- ifel(ndvi_2013 <= 0.1, NA, ndvi_2013)
ndvi_2025_veg <- ifel(ndvi_2025 <= 0.1, NA, ndvi_2025)

# Proietto correttamente i punti sul CRS di ciascun raster
punti_2013 <- project(punti_geo, crs(ndvi_2013_veg))
punti_2025 <- project(punti_geo, crs(ndvi_2025_veg))

# Creo del buffer di 100 metri
punti_buffer_2013 <- buffer(punti_2013, width = 100)
punti_buffer_2025 <- buffer(punti_2025, width = 100)

# Estraggo i valori medi del buffer 
ext_2013 <- terra::extract(ndvi_2013_veg, punti_buffer_2013, fun = mean, na.rm = TRUE)
ext_2025 <- terra::extract(ndvi_2025_veg, punti_buffer_2025, fun = mean, na.rm = TRUE)

ext_2013 # mi servono i valori dell'ultima colonna

# Creo il dataframe
risultato_intorno <- dati_punti
risultato_intorno$NDVI_Buffer_2013 <- ext_2013[[ncol(ext_2013)]]
risultato_intorno$NDVI_Buffer_2025 <- ext_2025[[ncol(ext_2025)]]

# Delta NDVI 
#differenza tra 2025 e 2013
risultato_intorno$Delta_NDVI_Buffer <- risultato_intorno$NDVI_Buffer_2025 - risultato_intorno$NDVI_Buffer_2013

# Salvataggio file.csv
write.csv2(risultato_intorno, "valori_ndvi_buffer_100m.csv", row.names = FALSE)


