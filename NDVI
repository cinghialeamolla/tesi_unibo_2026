### Calcolo NDVI

setwd("C:/RTesi")

# 1. Installa e carica il pacchetto terra
# install.packages("terra")
library(terra)

# --- CALCOLO LANDSAT 8 (2013) ---

# 2. Carico le bande di Landsat 8

b4_2013 <- rast("C:/RTesi/16_giugno_2013_LC08_B4.TIF") # Rosso
b5_2013 <- rast("C:/RTesi/16_giugno_2013_LC08_B5.TIF") # Vicino Infrarosso

# 3. Applico la formula NDVI
ndvi_2013 <- (b5_2013 - b4_2013) / (b5_2013 + b4_2013)

# 4. Salvo il risultato in un nuovo file GeoTIFF geografico
writeRaster(ndvi_2013, "ndvi_ombrone_2013.tif", overwrite=TRUE)


# --- CALCOLO SENTINEL-2 (2025) ---

# 5. Carico le bande di Sentinel-2
b4_2025 <- rast("C:/RTesi/24_maggio_2025_Sentinel-2_L2A_B04_(Raw).tiff") # Rosso
b8_2025 <- rast("C:/RTesi/24_maggio_2025_Sentinel-2_L2A_B08_(Raw).tiff") # Vicino Infrarosso

# 6. Applico la formula NDVI
ndvi_2025 <- (b8_2025 - b4_2025) / (b8_2025 + b4_2025)

# 7. Salvo il risultato
writeRaster(ndvi_2025, "ndvi_ombrone_2025.tif", overwrite=TRUE)

####### --- CALCOLO SENTINEL-2 (2025-tagli) --- ####

# a. Carico le bande di Sentinel-2
b4_T2025 <- rast("C:/RTesi/Tagli_2025_Sentinel-2_L2A_B04_(Raw).tiff") # Rosso
b8_T2025 <- rast("C:/RTesi/Tagli_2025_Sentinel-2_L2A_B08_(Raw).tiff") # Vicino Infrarosso
band_Red_resampled <- resample(b4_T2025, b8_T2025)

# b. Applico la formula NDVI
ndvi_T2025 <- (b8_T2025 - band_Red_resampled) / (b8_T2025 + band_Red_resampled)

# c. Salvo il risultato
writeRaster(ndvi_T2025, "ndvi_tagli_2025.tif", overwrite=TRUE)




# 8. Ricampiono per far combaciare i pixel di Lansat 8 (2013) e Sentinel 2 (2025)
resample(ndvi_2013, ndvi_2025)

