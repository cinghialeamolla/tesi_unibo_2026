doc_ndvi <- body_add_flextable(doc_ndvi, value = tabella_completa)

print(doc_ndvi, target = "C:/RTesi/tabella_medie_ndvi_2025.docx")
print("--- TABELLA WORD GENERATA CON SUCCESSO ---")



# =====================================================================
# ---- ANOVA PER NDVI (2025) ----
# =====================================================================

anova_NDVI <- lm(NDVI ~ NOME_TRATTO, data = seg_2025_corretto)
print(summary(anova_NDVI))


# verifica degli assunti dell'ANOVA: importante, da fare prima di guardare i risultati!
# perché se gli assunti non sono rispettati dobbiamo passare al blocco di analisi successivo
shapiro.test(residuals(anova_NDVI)) # p-value = 0.4603, è superiore a 0,05, significa che è i residui sono normali

levene_S <- leveneTest(NDVI ~ NOME_TRATTO, data = seg_2025_corretto)
print(levene_S) # p-value=0.005068 < p-vaue 0,05; quindi le varianze non sono omogenee

# DEVO USARE UN ALTRO MODELLO PER L'ANOVA

# Imposto il modello "Generalized Linear Models"
gls_ndvi <- gls(NDVI ~ NOME_TRATTO, 
                        data = seg_2025_corretto, 
                        weights = varIdent(form = ~ 1 | NOME_TRATTO))

Anova(gls_ndvi, type = "III")

# Calcolo dei confronti post-hoc di Tukey per varianze diverse
confronti_posthoc <- emmeans(gls_ndvi, pairwise ~ NOME_TRATTO, adjust = "tukey")

# VisualizzO i risultati dei contrasti a coppie
print(confronti_posthoc$contrasts)

# OUTPUT p.value
# Monte - Tagli   p.value <0.0001 > 0.05
# Monte - Valle   p.value <0.0001 < 0.05
# Tagli - Valle   p.value <0.0001 < 0.05


# =====================================================================
# CEAZIONE TABELLA
# =====================================================================


# Trasformo l'oggetto emmeans in un dataframe pulito
df_contrasti <- as.data.frame(confronti_posthoc$contrasts)

#  Creo la tabella con flextable impostando i parametri anti-warning
tabella_word_contrasti <- flextable(df_contrasti) %>%
  set_header_labels(
    contrast = "Confronto Tratti",
    estimate = "Stima Diff.",
    SE       = "Errore Standard (SE)",
    df       = "g.l. (Satterthwaite)",
    t.ratio  = "Valore t",
    p.value  = "p-value"
  ) %>%
  # big.mark = "" evita i conflitti con la virgola decimale nei sistemi italiani
  colformat_double(digits = 4, decimal.mark = ",", big.mark = "") %>%
  # Gestione specifica dei p-value  (< 0,0001)
  colformat_double(j = "p.value", digits = 4, decimal.mark = ",", na_str = "") %>%
  theme_booktabs() %>%
  autofit() %>%
  bold(part = "header") %>%
  flextable::align(align = "center", part = "all") %>%
  flextable::align(j = "contrast", align = "left", part = "all")

#  Creo un nuovo documento Word separato
doc_contrasti <- read_docx()

# Aggiungo il titolo del paragrafo/tabella
doc_contrasti <- body_add_par(
  doc_contrasti, 
  "Tabella 1.2: Contrasti post-hoc di Tukey (metodo GLS) per i valori di NDVI (Anno 2025)", 
  style = "heading 2"
)

# Inserisco la tabella appena creata
doc_contrasti <- body_add_flextable(doc_contrasti, value = tabella_word_contrasti)

# Salvo il file
print(doc_contrasti, target = "C:/RTesi/tabella_contrasti_ndvi_2025.docx")

