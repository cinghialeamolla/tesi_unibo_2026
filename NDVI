## ---- load data ----
setwd("C:/RTesi")

{
  specie <- readxl::read_xlsx(
    "C:/RTesi/dati_ombrone_provvisori.xlsx",
    sheet = "Contatti_Specie"
  )
  segmenti <- readxl::read_xlsx(
    "C:/RTesi/dati_ombrone_provvisori.xlsx",
    sheet = "Segmenti"
  )
}

## ---- data preparation ----
{
  # Filtriamo i segmenti del 2025
  seg_2025 <- segmenti %>%
    filter(ANNO == 2025)

  # Filtriamo i contatti del 2025 e aggreghiamo per segmento (sommando le sponde)
  # per avere il dato totale del segmento da confrontare tra i tre tratti
  specie_2025 <- specie %>%
    filter(ID_SEGMENTO %in% seg_2025$ID_SEGMENTO) %>%
    group_by(ID_SEGMENTO, SPECIE) %>%
    summarise(CONTEGGIO_TOT = sum(CONTEGGIO), .groups = "drop")

  # Trasformiamo in formato WIDE (Siti x Specie) per il pacchetto vegan
  matrice_comunita <- specie_2025 %>%
    pivot_wider(
      names_from = SPECIE,
      values_from = CONTEGGIO_TOT,
      values_fill = 0
    ) %>%
    column_to_rownames("ID_SEGMENTO")
}


# =====================================================================
# ---- TABELLA NDVI PER TRATTO (2025) ----
# =====================================================================

# Trasformo la colonna NDVI da "carattere" a "numerica" prima del calcolo
seg_2025_corretto <- seg_2025 %>%
  mutate(NDVI = as.numeric(as.character(NDVI))) 

# Ricalcolo delle statistiche descrittive
tabella_ndvi_dati <- seg_2025_corretto %>%
  group_by(NOME_TRATTO) %>%
  summarise(
    Numero_Segmenti = n(),
    NDVI_Medio      = mean(NDVI, na.rm = TRUE),
    Deviazione_Std  = sd(NDVI, na.rm = TRUE),
    Minimo          = min(NDVI, na.rm = TRUE),
    Massimo         = max(NDVI, na.rm = TRUE),
    .groups = "drop"
  )

# Creo la tabella risolvendo il conflitto di 'align'
# Uso flextable::align per dire a R di ignorare il pacchetto terra in questo blocco (altrimenti continua a dare errori di conflitto)

tabella_completa <- flextable(tabella_ndvi_dati) %>%
  set_header_labels(
    NOME_TRATTO     = "Tratto di Fiume",
    Numero_Segmenti = "N° Segmenti",
    NDVI_Medio      = "NDVI Medio",
    Deviazione_Std  = "Deviazione Standard",
    Minimo          = "Min",
    Massimo         = "Max"
  ) %>%
  # Rimuovo completamente i separatori delle migliaia per evitare conflitti con le impostazioni di sistema
  # continuava a dari dei warning
  colformat_double(digits = 3, decimal.mark = ",", big.mark = "") %>% 
  colformat_int(j = "Numero_Segmenti", big.mark = "") %>% 
  theme_booktabs() %>%                
  autofit() %>%                       
  bold(part = "header") %>%           
  flextable::align(align = "center", part = "all") %>% 
  flextable::align(j = "NOME_TRATTO", align = "left", part = "all")


# La esporto in word
