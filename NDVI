### Calcolo NDVI

setwd("C:/RTesi")

# 1. Installa e carica il pacchetto terra
# install.packages("terra")
library(terra)

# --- CALCOLO LANDSAT 8 (2013) ---

# 2. Carico le bande di Landsat 8

b4_2013 <- rast("C:/RTesi/16_giugno_2013_LC08_B4.TIF") # Rosso
b5_2013 <- rast("C:/RTesi/16_giugno_2013_LC08_B5.TIF") # Vicino Infrarosso

# 3. Applico la formula NDVI
ndvi_2013 <- (b5_2013 - b4_2013) / (b5_2013 + b4_2013)

# 4. Salvo il risultato in un nuovo file GeoTIFF geografico
writeRaster(ndvi_2013, "ndvi_ombrone_2013.tif", overwrite=TRUE)


# --- CALCOLO SENTINEL-2 (2025) ---

# 5. Carico le bande di Sentinel-2
b4_2025 <- rast("C:/RTesi/24_maggio_2025_Sentinel-2_L2A_B04_(Raw).tiff") # Rosso
b8_2025 <- rast("C:/RTesi/24_maggio_2025_Sentinel-2_L2A_B08_(Raw).tiff") # Vicino Infrarosso

# 6. Applico la formula NDVI
ndvi_2025 <- (b8_2025 - b4_2025) / (b8_2025 + b4_2025)

# 7. Salvo il risultato
writeRaster(ndvi_2025, "ndvi_ombrone_2025.tif", overwrite=TRUE)


# 8. Ricampiono per far combaciare i pixel di Lansat 8 (2013) e Sentinel 2 (2025)
resample(ndvi_2013, ndvi_2025)

# class       : SpatRaster
# size        : 1297, 1964, 1  (nrow, ncol, nlyr)
# resolution  : 8.985132e-05, 6.603547e-05  (x, y)
# extent      : 11.00573, 11.18219, 42.6485, 42.73415  (xmin, xmax, ymin, ymax)
# coord. ref. : WGS 84 / UTM zone 32N (EPSG:32632)
# source(s)   : memory
# varname     : 24_maggio_2025_Sentinel-2_L2A_B08_(Raw)
# name        : 16_giugno_2013_LC08_B5
# min value   :                    NaN
# max value   :                    NaN


# 9. Visualizzo un'anteprima veloce a schermo
par(mfrow=c(2,1))
plot(ndvi_2025, main="NDVI Grosseto 2025", col=rev(terrain.colors(10)))
plot(ndvi_2013, main="NDVI Grosseto 2013", col=rev(terrain.colors(10)))



## SALVARE DATI NDVI
# 1. Carica i tuoi raster NDVI
setwd("C:/RTesi")
library(terra)

ndvi_2013 <- rast("ndvi_ombrone_2013.tif")
ndvi_2025 <- rast("ndvi_ombrone_2025.tif")

# 2. Carica i punti (esempio da CSV)
# Indica a R il punto e virgola come separatore di colonna e la virgola come decimale
dati_punti <- read.csv("punti.csv", sep = ";", dec = ",")

# Ora puoi lanciare vect indicando le colonne separate
punti_geo <- vect(dati_punti, geom = c("est", "nord"), crs = "EPSG:32632")


# 4. ALLINEAMENTO DEI SISTEMI DI RIFERIMENTO
# Landsat e Sentinel per Grosseto usano spesso la zona UTM 32N (32632) o 33N (32633).
# Questa riga converte automaticamente i punti SOLO se il raster ha una zona diversa.
punti_proiettati_2013 <- project(punti_geo, crs(ndvi_2013))
punti_proiettati_2025 <- project(punti_geo, crs(ndvi_2025))

# 5. ESTRAI I VALORI
valori_2013 <- extract(ndvi_2013, punti_proiettati_2013)
valori_2025 <- extract(ndvi_2025, punti_proiettati_2025)

# 6. CREA IL REPORT FINALE
risultato_finale <- data.frame(
  Dati_Originali = dati_punti, 
  NDVI_2013      = valori_2013[, 2], # Estrae la colonna con i valori del pixel
  NDVI_2025      = valori_2025[, 2]
)

# Calcola la differenza temporale
risultato_finale$Delta_NDVI <- risultato_finale$NDVI_2025 - risultato_finale$NDVI_2013

# Salva il file finale usando il punto e virgola (standard italiano per Excel)
write.csv2(risultato_finale, "valori_ndvi_32632.csv", row.names = FALSE)
